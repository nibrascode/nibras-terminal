G
          ;;
      esac
    fi
    gradle_dist && (cd "$dir" && gradle -q wrapper --gradle-version "$GRADLE_VER" >/dev/null 2>&1) || true
    command -v git >/dev/null 2>&1 && (cd "$dir" && git init -q && git add -A && git -c user.name=Nibras -c user.email=nibras@localhost commit -qm "New $tpl project" 2>/dev/null) || true
    echo "✓ $dir ($tpl)  →  nibras-apk run $dir" ;;
  build)
    dir="${1:-.}"; task="${2:-assembleDebug}"; [ -f "$SDK/build-tools/$BT/aapt2" ] || setup --sdk
    cd "$dir"; [ -f local.properties ] || echo "sdk.dir=$SDK" > local.properties
    if [ -x ./gradlew ]; then G=./gradlew; else gradle_dist; G=/opt/gradle/bin/gradle; fi
    $G "$task" -Pandroid.aapt2FromMavenOverride="$SDK/build-tools/$BT/aapt2"
    find . -path '*/build/outputs/*' \( -name '*.apk' -o -name '*.aab' -o -name '*.aar' \) -newer local.properties 2>/dev/null | sed 's/^/✓ /' ;;
  clean|tasks|deps|dependencies) dir="${1:-.}"; cd "$dir"; [ -x ./gradlew ] && G=./gradlew || { gradle_dist; G=/opt/gradle/bin/gradle; }
    case "$cmd" in clean) $G clean ;; tasks) $G tasks ;; *) $G :app:dependencies --configuration debugRuntimeClasspath ;; esac ;;
  install|i)
    t="${1:-.}"; [ -d "$t" ] && t=$(apk_out "$t")
    [ -f "$t" ] || { echo "no APK found — build first: nibras-apk build"; exit 1; }
    nibras-api install-apk "$(readlink -f "$t")" ;;
  run)
    dir="${1:-.}"; "$0" build "$dir" assembleDebug
    a=$(apk_out "$dir"); [ -n "$a" ] || exit 1
    nibras-api install-apk "$(readlink -f "$a")"
    id=$(app_id "$dir")
    if [ -n "$id" ]; then
      echo "After installing, starting $id …"
      for i in $(seq 1 60); do sleep 2; nibras-api am start -a android.intent.action.MAIN -c android.intent.category.LAUNCHER -p "$id" >/dev/null 2>&1 && { echo "▶ $id"; break; }; done
    fi ;;
  logcat)
    if command -v adb >/dev/null 2>&1 && adb get-state >/dev/null 2>&1; then
      if [ -n "${1:-}" ]; then pid=$(adb shell pidof "$1" | tr -d '\r'); [ -n "$pid" ] && exec adb logcat --pid="$pid" -v color; fi
      exec adb logcat -v color
    fi
    echo "(Without nibras-adb pairing Android shows only Nibras Terminal's own log. Pair once: nibras-adb pair)" >&2
    exec nibras-tools logcat -v color ;;
  decompile|d) need apktool; in="${1:?apk}"; out="${2:-${in%.apk}}"; apktool d -f "$in" -o "$out" && echo "✓ $out" ;;
  recompile|b) need apktool; dir="${1:?dir}"; out="${2:-${dir%/}-mod.apk}"; apktool b "$dir" -o "$out.unsigned.apk"
    "$0" align "$out.unsigned.apk" >/dev/null; mv "$out.unsigned.apk" "$out"; "$0" sign "$out" ;;
  java|jadx) need jadx; in="${1:?apk}"; out="${2:-${in%.apk}-java}"; jadx -d "$out" "$in" && echo "✓ $out" ;;
  manifest) need aapt2; aapt2 dump xmltree --file AndroidManifest.xml "${1:?apk}" 2>/dev/null || aapt d xmltree "$1" AndroidManifest.xml ;;
  info) need aapt; aapt dump badging "${1:?apk}" | grep -E "^(package|sdkVersion|targetSdkVersion|uses-permission|native-code|application-label:|launchable)" ;;
  keystore) jdk; ks="${1:-$HOME/.nibras/release.jks}"; alias="${2:-nibras}"; mkdir -p "$(dirname "$ks")"
    keytool -genkeypair -v -keystore "$ks" -alias "$alias" -keyalg RSA -keysize 4096 -validity 10000 && chmod 600 "$ks" && echo "✓ $ks ($alias)" ;;
  align) need zipalign; in="${1:?apk}"; zipalign -f -p 4 "$in" "$in.aligned" && mv "$in.aligned" "$in" && echo "✓ aligned $in" ;;
  sign) [ -f "$SDK/build-tools/$BT/lib/apksigner.jar" ] || setup; in="${1:?apk}"; ks="${2:-$HOME/.nibras/release.jks}"; alias="${3:-nibras}"
    [ -f "$ks" ] || "$0" keystore "$ks" "$alias"
    zipalign -c -p 4 "$in" >/dev/null 2>&1 || "$0" align "$in"
    apksigner_ sign --ks "$ks" --ks-key-alias "$alias" --v1-signing-enabled true --v2-signing-enabled true --v3-signing-enabled true "$in" && echo "✓ signed $in" ;;
  verify) [ -f "$SDK/build-tools/$BT/lib/apksigner.jar" ] || setup; apksigner_ verify -v --print-certs "${1:?apk}" ;;
  dex|d8) [ -f "$SDK/build-tools/$BT/lib/d8.jar" ] || setup; in="${1:?jar}"; out="${2:-.}"; mkdir -p "$out"
    java -cp "$SDK/build-tools/$BT/lib/d8.jar" com.android.tools.r8.D8 --min-api 21 --output "$out" "$in" && echo "✓ $out/classes.dex" ;;
  wizard) # Sketchware-style guided project: answer a few questions, get a building app
    printf 'App name [MyApp]: '; read -r an; an=${an:-MyApp}
    dn=$(echo "$an" | tr -cd 'A-Za-z0-9'); [ -n "$dn" ] || dn=MyApp
    printf 'Package [com.example.%s]: ' "$(echo "$dn" | tr A-Z a-z)"; read -r pk; pk=${pk:-com.example.$(echo "$dn" | tr A-Z a-z)}
    echo "Screen type: 1) button (views)  2) list  3) form  4) website/HTML (webview)  5) Kotlin  6) Compose  7) empty (basic)"
    printf 'Choose [1]: '; read -r ch
    case "${ch:-1}" in 2) t=list ;; 3) t=form ;; 4) t=webview; printf 'URL (empty = built-in HTML page): '; read -r u; [ -n "$u" ] && export NIBRAS_URL="$u" ;; 5) t=kotlin ;; 6) t=compose ;; 7) t=basic ;; *) t=views ;; esac
    "$0" new "$HOME/$dn" "$pk" --template "$t"
    sed -i "s#<string name=\"app_name\">[^<]*#<string name=\"app_name\">$an#" "$HOME/$dn/app/src/main/res/values/strings.xml"
    printf 'Build and install now? [Y/n] '; read -r go; case "$go" in n|N) echo "Later: nibras-apk run ~/$dn" ;; *) "$0" run "$HOME/$dn" ;; esac ;;
  debugkey) # throw-away debug signing key (public "android" password, like Android Studio's debug.keystore)
    jdk >/dev/null; ks="$HOME/.nibras/debug.keystore"; mkdir -p "$HOME/.nibras"
    [ -f "$ks" ] || keytool -genkeypair -keystore "$ks" -alias androiddebugkey -storepass android -keypass android -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=Android Debug,O=Android,C=US" >/dev/null 2>&1
    echo "$ks" ;;
  signdebug) [ -f "$SDK/build-tools/$BT/lib/apksigner.jar" ] || setup; in="${1:?apk}"; ks=$("$0" debugkey)
    zipalign -c -p 4 "$in" >/dev/null 2>&1 || "$0" align "$in" >/dev/null
    apksigner_ sign --ks "$ks" --ks-pass pass:android --key-pass pass:android --ks-key-alias androiddebugkey "$in" && echo "✓ signed (debug key) $in" ;;
  rebuild) # one tap from the resource editor: apktool b → zipalign → sign (debug key unless a keystore is given) → install
    need apktool; dir="${1:?dir}"; out="${dir%/}-mod.apk"; apktool b "$dir" -o "$out.unsigned.apk" && "$0" align "$out.unsigned.apk" >/dev/null && mv "$out.unsigned.apk" "$out"
    if [ -n "${2:-}" ]; then "$0" sign "$out" "$2" "${3:-nibras}"; else "$0" signdebug "$out"; fi
    echo "✓ $out"; printf 'Install now? [Y/n] '; read -r a; case "$a" in n|N) ;; *) nibras-api install-apk "$(readlink -f "$out")" ;; esac ;;
  res|resources|edit-res) # visual resource editor (strings per language, colors, icons/drawables, app name/package/version)
    t="${1:-.}"
    if [ -f "$t" ]; then need apktool; out="${2:-${t%.apk}}"; apktool d -f -s "$t" -o "$out" >/dev/null && t="$out"; fi
    nibras-api res-edit "$(readlink -f "$t")" ;;
  baksmali|dex2smali) [ -f "$TOOLS/baksmali.jar" ] || fetch https://github.com/baksmali/smali/releases/download/3.0.10/baksmali-3.0.10-fat-release.jar "" "$TOOLS/baksmali.jar"
    jdk >/dev/null; in="${1:?classes.dex|app.apk}"; out="${2:-${in%.*}-smali}"; java -jar "$TOOLS/baksmali.jar" d "$in" -o "$out" && echo "✓ $out (edit .smali, then: nibras-apk smali $out)" ;;
  smali|smali2dex) [ -f "$TOOLS/smali.jar" ] || fetch https://github.com/baksmali/smali/releases/download/3.0.10/smali-3.0.10-fat-release.jar "" "$TOOLS/smali.jar"
    jdk >/dev/null; in="${1:?smali dir}"; out="${2:-classes.dex}"; java -jar "$TOOLS/smali.jar" a "$in" -o "$out" && echo "✓ $out" ;;
  apkeditor) [ -f "$TOOLS/APKEditor.jar" ] || fetch https://github.com/REAndroid/APKEditor/releases/download/V1.4.9/APKEditor-1.4.9.jar "" "$TOOLS/APKEditor.jar"
    jdk >/dev/null; java -jar "$TOOLS/APKEditor.jar" "$@" ;;
  merge|antisplit) # split APKs / .apks / .xapk / .apkm (unencrypted) / folder → one installable APK (APKTool M, MT Manager)
    in="${1:?app.apks|app.xapk|app.apkm|dir}"; out="${2:-${in%.*}-merged.apk}"
    "$0" apkeditor m -i "$in" -o "$out" -f && "$0" signdebug "$out" && echo "✓ $out" ;;
  install-split|isplit|install-apks) nibras-api install-apks "$@" ;;
  arsc|refactor) "$0" apkeditor "$@" ;; # APKEditor: d/b (resources.arsc ↔ JSON/XML), refactor (readable resource names), info
  protect|obfuscate-res) in="${1:?apk}"; out="${2:-${in%.apk}-protected.apk}"; "$0" apkeditor p -i "$in" -o "$out" -f && "$0" signdebug "$out" ;;
  optimize|shrink) # APK: aapt2 optimize (short paths + collapsed resource names); project: R8 minify + shrinkResources
    t="${1:?app.apk|project dir}"
    if [ -d "$t" ]; then f=$(ls "$t"/app/build.gradle* 2>/dev/null | head -1); [ -n "$f" ] || { echo "no app/build.gradle"; exit 1; }
      grep -q minifyEnabled "$f" || sed -i "0,/android {/s//android {\n  buildTypes { release { minifyEnabled true; shrinkResources true; proguardFiles getDefaultProguardFile('proguard-android-optimize.txt') } }/" "$f"
      echo "✓ R8 (code shrink + obfuscation) and resource shrinking on for release → nibras-apk build $t assembleRelease"
    else need aapt2; out="${2:-${t%.apk}-opt.apk}"
      aapt2 optimize --shorten-resource-paths --collapse-resource-names -o "$out" "$t" && "$0" signdebug "$out" && ls -l "$t" "$out" | awk '{print $5, $NF}'
    fi ;;
  rename|clone) # App Cloner style: new package name (installs next to the original) + optional new label
    need apktool; in="${1:?app.apk}"; np="${2:?new.package.name}"; label="${3:-}"
    w="${in%.apk}-clone"; apktool d -f -s "$in" -o "$w" >/dev/null
    old=$(grep -o 'package="[^"]*"' "$w/AndroidManifest.xml" | head -1 | cut -d'"' -f2)
    sed -i "s/^\(  renameManifestPackage:\).*/\1 $np/" "$w/apktool.yml"; grep -q renameManifestPackage: "$w/apktool.yml" || printf 'packageInfo:\n  renameManifestPackage: %s\n' "$np" >> "$w/apktool.yml"
    sed -i "s/android:authorities=\"$old/android:authorities=\"$np/g; s/\"$old\.permission\./\"$np.permission./g" "$w/AndroidManifest.xml"
    if [ -n "$label" ]; then sed -i "s#\(<application[^>]*android:label=\"\)[^\"]*#\1$label#" "$w/AndroidManifest.xml"; fi
    out="${in%.apk}-$np.apk"; apktool b "$w" -o "$out" >/dev/null && "$0" signdebug "$out" && echo "✓ $out ($old → $np). Apps that check their own signature or package may refuse to run." ;;
  translate) # add a language to an app/project: copies values/strings.xml → values-<lang>/strings.xml, then the table editor
    d="${1:?res dir or project}"; l="${2:?language code, e.g. az}"
    r=$( [ -d "$d/res" ] && echo "$d/res" || { [ -d "$d/app/src/main/res" ] && echo "$d/app/src/main/res"; } || echo "$d")
    [ -f "$r/values/strings.xml" ] || { echo "no $r/values/strings.xml"; exit 1; }
    mkdir -p "$r/values-$l"; [ -f "$r/values-$l/strings.xml" ] || cp "$r/values/strings.xml" "$r/values-$l/strings.xml"
    echo "✓ $r/values-$l/strings.xml — translate in the table: nibras-apk res $d"; nibras-api res-edit "$(readlink -f "$d")" >/dev/null 2>&1 || true ;;
