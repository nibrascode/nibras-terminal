    echo "Only for apps you own or are authorised to test."; command -v npx >/dev/null 2>&1 || nibras-need nodejs npm || nibras-need node
    jdk >/dev/null; npx --yes apk-mitm "$@" ;;
  apps) [ $# -gt 0 ] || set -- list; nibras-api apps "$@" ;;                  # installed apps (App Manager)
  appinfo) nibras-api apps info "${1:?package}" ;;       # manifest data, permissions, components, signer
  extract|backup) nibras-api apps extract "${1:?package}" "${2:-.}" ;;  # APK Extractor (base + splits → .apks)
  exported) nibras-api apps exported "${1:?package}" ;;  # exported components (security review)
  sigcheck|signature) "$0" verify "${1:?apk}" | grep -E "Verified using|Signer #1 certificate (DN|SHA-256)|WARNING|DOES NOT VERIFY" ;;
  diff) need apktool; a="${1:?old.apk}"; b="${2:?new.apk}"; apktool d -f -s "$a" -o /tmp/nd-a >/dev/null; apktool d -f -s "$b" -o /tmp/nd-b >/dev/null
