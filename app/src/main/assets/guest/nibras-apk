G
          ;;
        webview) mkdir -p "$dir/app/src/main/assets"
          url="${NIBRAS_URL:-file:///android_asset/index.html}"
          cat > "$dir/app/src/main/assets/index.html" <<G
<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><meta charset="utf-8">
<style>body{font-family:sans-serif;padding:24px;text-align:center}button{font-size:18px;padding:10px 24px}</style></head>
<body><h2>$name</h2><p>Built with Nibras Terminal</p><button onclick="n.textContent=++c">Tap</button> <b id="n">0</b>
<script>var c=0</script></body></html>
G
          cat > "$dir/app/src/main/java/$p/MainActivity.java" <<G
package $pkg;

import android.app.Activity;
import android.os.Bundle;
import android.webkit.WebSettings;
import android.webkit.WebView;
import android.webkit.WebViewClient;

public class MainActivity extends Activity {
    private WebView web;

