#!/bin/sh
# nibras-apk: build, take apart, change, sign and read Android apps on the phone (arm64 + arm32).
# Built on open-source tools: Gradle, apktool, jadx, smali, APKEditor, Android build-tools.
#   nibras-apk setup [--sdk]          JDK, apktool, jadx, aapt/aapt2/zipalign (+ Android SDK for Gradle builds)
#   nibras-apk new <dir> [package]    minimal Gradle project that builds on the phone
#   nibras-apk build [dir] [task]     Gradle build (default assembleDebug), aapt2 from the phone
#   nibras-apk decompile <app.apk> [out]   apktool d (resources + smali)
#   nibras-apk recompile <dir> [out.apk]   apktool b, then zipalign + sign
#   nibras-apk java <app.apk> [out]   jadx: dex → Java sources
#   nibras-apk manifest <app.apk>     readable AndroidManifest.xml
#   nibras-apk info <app.apk>         package, versions, SDKs, permissions, ABIs
#   nibras-apk keystore [file] [alias] create a signing key (keytool)
#   nibras-apk sign <app.apk> [keystore] [alias]   zipalign + apksigner (v1+v2+v3)
#   nibras-apk verify <app.apk>       apksigner verify --print-certs
#   nibras-apk align <app.apk>        zipalign -p 4
#   nibras-apk dex <classes.jar|dir> [out]   d8 → classes.dex
#   nibras-apk new <dir> [package] [--template basic|views|kotlin|compose|library]   project templates
#   nibras-apk install [app.apk|dir]  open Android's installer for the built APK
#   nibras-apk run [dir]              build → install → launch (the editor's ▶ Run)
#   nibras-apk logcat [package]       app logs (full logcat through nibras-adb when paired)
#   nibras-apk clean|tasks|deps [dir] gradle clean / task list / dependency tree
#   nibras-apk jdk [17|21] · gradle · templates
#   nibras-apk wizard                 guided new app (button, list, form, website, Kotlin, Compose) → build → install
#   nibras-apk res <app.apk|dir>      visual resource editor: strings per language, colors, icons, name/package/version
#   nibras-apk rebuild <dir> [ks]     apktool b → zipalign → sign (debug key or yours) → install
#   nibras-apk translate <dir> <lang> add values-<lang>/strings.xml and edit it in the table
#   nibras-apk baksmali <dex|apk> [out] · smali <dir> [out.dex]   dex ↔ smali (dex editing)
#   nibras-apk merge <apks|xapk|apkm|dir> [out.apk]   split APKs → one APK (antisplit, APKEditor)
#   nibras-apk install-split <files…|.apks|.xapk|.apkm>  install split APKs in one session
#   nibras-apk arsc d|b|refactor|info …   resources.arsc ↔ XML/JSON, readable names (APKEditor)
#   nibras-apk optimize <apk|project>  aapt2 optimize (short paths, collapsed names) · R8 + shrinkResources
#   nibras-apk protect <apk>          resource obfuscation (APKEditor p)
#   nibras-apk rename <apk> <new.pkg> [label]   clone with a new package name
#   nibras-apk sigcheck <apk> · diff <a.apk> <b.apk>   signature summary · what changed between two APKs
#   nibras-apk apps [list|-s|-a] · appinfo <pkg> · exported <pkg> · extract <pkg> [dir]   installed apps: list, details, back up
#   nibras-apk mitm <apk>             remove certificate pinning for testing your own apps (apk-mitm)
#   nibras-apk signdebug <apk> · debugkey   sign with a throw-away debug key
#   nibras-apk test [dir]             unit tests (testDebugUnitTest), like Android Studio
#   nibras-apk lint [dir]             Android lint (lintDebug)
#   nibras-apk analyze <apk|dir>      APK size: dex, resources, native libs, assets
#   nibras-apk assets <image> [dir]   one picture → launcher icons (mdpi … xxxhdpi)
#   nibras-apk perms [dir|apk] [list|+NAME|-NAME|--run]   toggle uses-permission, then rebuild if you ask
#   nibras-apk manifest edit          same as perms. "manifest <apk>" still prints the XML
#   nibras-apk db <pkg|file.db> [db] [sql]   your debug app's SQLite, or a .db file you already have
#   nibras-apk crash [package]        last lines from the crash buffer (wireless debugging: nibras-adb pair)
#   nibras-apk studio [dir]           open the project screen: run, files, layout, new activity
#   nibras-apk activity <Name> [dir]  new activity, layout and manifest entry
#   nibras-apk class <Name> [dir]     new Java or Kotlin class in the app package
#   nibras-apk screen <kind> <file>   layout: empty, button, list, form
#   nibras-apk dep <group:name:ver>   add an implementation dependency
#   nibras-apk sync [dir]             Gradle sync (tasks)
#   nibras-apk device                 this phone is the run device
#   nibras-apk errors                 file and line from the last Gradle failure
set -e
TOOLS=/opt/nibras-apk
SDK=/opt/android-sdk
BT=35.0.0
mkdir -p "$TOOLS/bin"
export PATH="$TOOLS/bin:$SDK/cmdline-tools/latest/bin:$SDK/build-tools/$BT:$PATH"
arch=$(uname -m)
case "$arch" in aarch64|arm64) sdkzip=android-sdk-tools-static-aarch64.zip; sdksum=db1cea2c4454d5f9c5a802646b2d1cf560b4ee7badbe23e51ab8e1881bb50fc2 ;;
  armv7*|armv8l|arm*) sdkzip=android-sdk-tools-static-arm.zip; sdksum=17b27ad0136b8d1c3ab67be24b3ab9a81c412c39fdc4112b622d900f90b02983 ;;
  *) sdkzip=""; sdksum="" ;; esac
fetch() { # url sha256 out
  echo "↓ $1"
  if command -v curl >/dev/null 2>&1; then curl -fL --retry 3 -o "$3" "$1"; else wget -O "$3" "$1"; fi
  if [ -n "$2" ]; then echo "$2  $3" | sha256sum -c - >/dev/null || { echo "SHA-256 mismatch: $3"; rm -f "$3"; exit 1; }; fi
}
jdk() {
  v=${1:-17}
  if command -v javac >/dev/null 2>&1 && [ -z "${1:-}" ]; then return; fi
  if command -v apk >/dev/null 2>&1; then apk add "openjdk$v-jdk" curl unzip
  elif command -v apt-get >/dev/null 2>&1; then export DEBIAN_FRONTEND=noninteractive; ls /var/lib/apt/lists/*_Packages >/dev/null 2>&1 || apt-get update
    apt-get install -y --no-install-recommends "openjdk-$v-jdk-headless" curl unzip ca-certificates
  elif command -v pacman >/dev/null 2>&1; then pacman -S --needed --noconfirm "jdk$v-openjdk" curl unzip
  elif command -v dnf >/dev/null 2>&1; then dnf install -y "java-$v-openjdk-devel" curl unzip; fi
  javac -version
}
GRADLE_VER=8.11.1
gradle_dist() { # Gradle new enough for AGP 8.x (distro packages are often too old)
  [ -x "/opt/gradle/bin/gradle" ] && return
  jdk; fetch "https://services.gradle.org/distributions/gradle-$GRADLE_VER-bin.zip" f397b287023acdba1e9f6fc5ea72d22dd63669d59ed4a289a29b1a76eee151c6 /tmp/gradle.zip
  rm -rf /opt/gradle "/opt/gradle-$GRADLE_VER"; unzip -q /tmp/gradle.zip -d /opt; mv "/opt/gradle-$GRADLE_VER" /opt/gradle; rm -f /tmp/gradle.zip
  ln -sf /opt/gradle/bin/gradle /usr/local/bin/gradle
  mkdir -p "$HOME/.gradle"; p="$HOME/.gradle/gradle.properties"
  for kv in "org.gradle.jvmargs=-Xmx1536m -Dfile.encoding=UTF-8" "org.gradle.vfs.watch=false" "org.gradle.parallel=false" "kotlin.compiler.execution.strategy=in-process"; do
    grep -q "^${kv%%=*}=" "$p" 2>/dev/null || echo "$kv" >> "$p"; done
  echo "✓ Gradle $GRADLE_VER"
}
apk_out() { find "${1:-.}" -path '*/build/outputs/apk/*' -name '*.apk' 2>/dev/null | xargs ls -t 2>/dev/null | head -n 1; }
app_id() { grep -hoE "applicationId[ =(]*['\"][^'\"]+" "${1:-.}"/app/build.gradle* 2>/dev/null | head -1 | sed -E "s/.*['\"]//"; }
setup() {
  jdk
  command -v curl >/dev/null 2>&1 || nibras-need curl; command -v unzip >/dev/null 2>&1 || nibras-need unzip
  if [ ! -f "$TOOLS/apktool.jar" ]; then
    fetch https://github.com/iBotPeaches/Apktool/releases/download/v3.0.3/apktool_3.0.3.jar \
      dbf930b076c6b9be08d57c449cacefc3bdd6b71ebd59b3066fc0e1f5b14f9423 "$TOOLS/apktool.jar"
  fi
  if [ ! -x "$TOOLS/jadx/bin/jadx" ]; then
    fetch https://github.com/skylot/jadx/releases/download/v1.5.7/jadx-1.5.7.zip \
      1755e4242ade71a077438723689f404079592ec7764a3a0572f98fef94ebcbf3 /tmp/jadx.zip
    rm -rf "$TOOLS/jadx"; mkdir -p "$TOOLS/jadx"; unzip -q /tmp/jadx.zip -d "$TOOLS/jadx"; rm -f /tmp/jadx.zip
    chmod +x "$TOOLS/jadx/bin/"*
  fi
  if [ -n "$sdkzip" ] && [ ! -x "$TOOLS/native/build-tools/aapt2" ]; then
    fetch "https://github.com/lzhiyong/android-sdk-tools/releases/download/35.0.2/$sdkzip" "$sdksum" /tmp/sdkt.zip
    rm -rf "$TOOLS/native"; mkdir -p "$TOOLS/native"; unzip -q /tmp/sdkt.zip -d "$TOOLS/native"; rm -f /tmp/sdkt.zip
    chmod +x "$TOOLS/native/build-tools/"* "$TOOLS/native/platform-tools/"*
  fi
  # apktool ships an x86_64 aapt2: point "apktool b" at the phone-native one.
  printf '#!/bin/sh\nc=$1; [ $# -gt 0 ] && shift\ncase "$c" in b|build) [ -x %s/native/build-tools/aapt2 ] && set -- "$c" --aapt %s/native/build-tools/aapt2 "$@" || set -- "$c" "$@" ;; *) set -- "$c" "$@" ;; esac\nexec java -jar %s/apktool.jar "$@"\n' "$TOOLS" "$TOOLS" "$TOOLS" > "$TOOLS/bin/apktool"
  ln -sf "$TOOLS/jadx/bin/jadx" "$TOOLS/bin/jadx"
  for t in aapt aapt2 zipalign dexdump aidl; do [ -x "$TOOLS/native/build-tools/$t" ] && ln -sf "$TOOLS/native/build-tools/$t" "$TOOLS/bin/$t"; done
  chmod +x "$TOOLS/bin/"*
  for t in apktool jadx aapt aapt2 zipalign; do ln -sf "$TOOLS/bin/$t" "/usr/local/bin/$t" 2>/dev/null || true; done
  if [ "${1:-}" = --sdk ] || [ ! -f "$SDK/build-tools/$BT/lib/apksigner.jar" ]; then sdk; fi
  echo "✓ nibras-apk: $(java -version 2>&1 | head -1) · apktool · jadx · aapt2 · zipalign · apksigner · d8"
}
sdk() {
  # cmdline-tools 20+ route sdkmanager through an x86_64-only "android" binary: keep the pure-Java 19.0.
  if [ ! -x "$SDK/cmdline-tools/latest/bin/sdkmanager" ] || [ -e "$SDK/cmdline-tools/latest/bin/android" ]; then
    fetch https://dl.google.com/android/repository/commandlinetools-linux-13114758_latest.zip "" /tmp/clt.zip
    echo "5fdcc763663eefb86a5b8879697aa6088b041e70  /tmp/clt.zip" | sha1sum -c - >/dev/null || { echo "SHA-1 mismatch"; exit 1; }
    mkdir -p "$SDK/cmdline-tools"; rm -rf "$SDK/cmdline-tools/latest" /tmp/clt
    unzip -q /tmp/clt.zip -d /tmp/clt; mv /tmp/clt/cmdline-tools "$SDK/cmdline-tools/latest"; rm -rf /tmp/clt.zip /tmp/clt
  fi
  echo "Android SDK: read and accept the licenses yourself (y/N):"
  sdkmanager --sdk_root="$SDK" --licenses
  sdkmanager --sdk_root="$SDK" "platforms;android-35" "build-tools;$BT"
  # Google ships x86_64 binaries: replace them with phone-native ones.
  for t in aapt aapt2 zipalign dexdump aidl split-select; do
    [ -x "$TOOLS/native/build-tools/$t" ] && cp -f "$TOOLS/native/build-tools/$t" "$SDK/build-tools/$BT/$t"
  done
  mkdir -p "$HOME/.gradle"
  grep -q aapt2FromMavenOverride "$HOME/.gradle/gradle.properties" 2>/dev/null || \
    echo "android.aapt2FromMavenOverride=$SDK/build-tools/$BT/aapt2" >> "$HOME/.gradle/gradle.properties"
  grep -q '^org.gradle.jvmargs' "$HOME/.gradle/gradle.properties" || echo "org.gradle.jvmargs=-Xmx1536m" >> "$HOME/.gradle/gradle.properties"
  echo "sdk.dir=$SDK" > "$HOME/.nibras/android-sdk.properties"
}
need() { command -v "$1" >/dev/null 2>&1 || [ -f "$SDK/build-tools/$BT/lib/$1.jar" ] || setup; }
apktool() { [ -f "$TOOLS/apktool.jar" ] && [ -x "$TOOLS/bin/apktool" ] && grep -q -- --aapt "$TOOLS/bin/apktool" || setup; "$TOOLS/bin/apktool" "$@"; }
apksigner_() { java -jar "$SDK/build-tools/$BT/lib/apksigner.jar" "$@"; }
gradle_exec() { # $G and local.properties already set; $1 is the task
  task="$1"
  mkdir -p "$HOME/.nibras"
  echo "→ $task"
  $G "$task" -Pandroid.aapt2FromMavenOverride="$SDK/build-tools/$BT/aapt2" > "$HOME/.nibras/studio.log" 2>&1 || {
    cat "$HOME/.nibras/studio.log"
    return 1
  }
  cat "$HOME/.nibras/studio.log"
}
gradle_task() { # dir task
  dir="${1:-.}"; task="${2:?task}"
  [ -f "$SDK/build-tools/$BT/aapt2" ] || setup --sdk
  cd "$dir"
  [ -f local.properties ] || echo "sdk.dir=$SDK" > local.properties
  if [ -x ./gradlew ]; then G=./gradlew; else gradle_dist; G=/opt/gradle/bin/gradle; fi
  gradle_exec "$task"
}
perm_norm() {
  p="$1"
  p=$(printf '%s' "$p" | tr -d '[:space:]')
  case "$p" in
    ""|android.permission.*) printf '%s\n' "$p" ;;
    *.*) printf '%s\n' "$p" ;;
    *) printf 'android.permission.%s\n' "$p" ;;
  esac
}
manifest_path() {
  t="${1:-.}"
  if [ -f "$t" ] && [ "${t%.apk}" != "$t" ]; then
    out="${t%.apk}-src"
    if [ ! -f "$out/AndroidManifest.xml" ]; then need apktool; apktool d -f -s "$t" -o "$out" >/dev/null; fi
    printf '%s\n' "$out/AndroidManifest.xml"
    return
  fi
  if [ -f "$t" ] && grep -q '<manifest' "$t" 2>/dev/null; then printf '%s\n' "$t"; return 0; fi
  if [ -f "$t/app/src/main/AndroidManifest.xml" ]; then printf '%s\n' "$t/app/src/main/AndroidManifest.xml"; return 0; fi
  if [ -f "$t/src/main/AndroidManifest.xml" ]; then printf '%s\n' "$t/src/main/AndroidManifest.xml"; return 0; fi
  if [ -f "$t/AndroidManifest.xml" ]; then printf '%s\n' "$t/AndroidManifest.xml"; return 0; fi
  echo "no AndroidManifest.xml in $t" >&2
  return 1
}
list_perms() {
  awk '
    /<uses-permission/ {
      s = $0
      if (s ~ /android:name="/) { sub(/.*android:name="/, "", s); sub(/".*/, "", s); print s }
    }
  ' "$1"
}
add_perm() {
  mf="$1"; p=$(perm_norm "$2")
  [ -n "$p" ] || { echo "empty permission"; return 1; }
  grep -q "android:name=\"$p\"" "$mf" && { echo "already there: $p"; return 0; }
  awk -v p="$p" '
    {
      if (!d && $0 ~ /<manifest[^>]*\/>/) {
        line = $0
        sub(/\/>$/, ">", line)
        print line
        print "    <uses-permission android:name=\"" p "\" />"
        print "</manifest>"
        d = 1
        next
      }
      if (!d && $0 ~ /<\/manifest>/) { print "    <uses-permission android:name=\"" p "\" />"; d = 1 }
      print
    }
    END { if (!d) exit 1 }
  ' "$mf" > "$mf.nibras" && mv "$mf.nibras" "$mf" || { echo "no </manifest> in $mf"; return 1; }
  echo "+ $p"
}
rm_perm() {
  mf="$1"; p=$(perm_norm "$2")
  grep -q "android:name=\"$p\"" "$mf" || { echo "not in the manifest: $p"; return 1; }
  grep -v "android:name=\"$p\"" "$mf" > "$mf.nibras" && mv "$mf.nibras" "$mf"
  echo "- $p"
}
rebuild_manifest() {
  mf="$1"; d=$(dirname "$mf"); i=0
  if [ -f "$d/apktool.yml" ]; then "$0" rebuild "$d"; return; fi
  while [ "$i" -lt 6 ]; do
    if [ -f "$d/settings.gradle" ] || [ -f "$d/settings.gradle.kts" ]; then "$0" run "$d"; return; fi
    d=$(dirname "$d"); i=$((i + 1))
  done
  echo "Saved $mf"
  echo "Next: nibras-apk run <project>    or    nibras-apk rebuild <apktool dir>"
}
perms_cmd() {
  target="${1:-.}"; [ $# -gt 0 ] && shift
  mf=$(manifest_path "$target") || exit 1
  [ -f "$mf" ] || { echo "missing $mf"; exit 1; }
  run=0; acted=0
  if [ $# -eq 0 ]; then
    echo "$mf"
    list_perms "$mf" | awk '{printf "%2d  %s\n", NR, $0}'
    if [ -t 0 ]; then
      echo "A number removes that line. +NAME adds it (CAMERA or the full name). q quits."
      while true; do
        printf '> '
        read -r ans || break
        case "$ans" in
          q|Q) break ;;
          "") break ;;
          +*) add_perm "$mf" "${ans#+}" ;;
          -*) rm_perm "$mf" "${ans#-}" ;;
          *[!0-9]*) echo "number, +NAME, -NAME, or q" ;;
          *)
            p=$(list_perms "$mf" | sed -n "${ans}p")
            [ -n "$p" ] && rm_perm "$mf" "$p" || echo "no line $ans"
            ;;
        esac
      done
      printf 'Build and install now? [y/N] '
      read -r go || true
      case "$go" in y|Y) rebuild_manifest "$mf" ;; *) echo "Saved $mf" ;; esac
    fi
    return 0
  fi
  for a in "$@"; do
    case "$a" in
      --run) run=1 ;;
      list) echo "$mf"; list_perms "$mf" | sed 's/^/  /' || true; acted=1 ;;
      +*) add_perm "$mf" "${a#+}"; acted=1 ;;
      -*) rm_perm "$mf" "${a#-}"; acted=1 ;;
      *) echo "usage: nibras-apk perms <dir|apk> [list|+NAME|-NAME|--run]"; exit 1 ;;
    esac
  done
  [ "$acted" = 0 ] && { echo "$mf"; list_perms "$mf" | sed 's/^/  /' || true; }
  [ "$run" = 1 ] && rebuild_manifest "$mf"
}
analyze_cmd() {
  t="${1:-.}"
  if [ -d "$t" ]; then
    t=$(apk_out "$t")
    [ -n "$t" ] || { echo "no APK yet. Build first: nibras-apk build"; exit 1; }
  fi
  [ -f "$t" ] || { echo "not a file: ${1:-}"; exit 1; }
  command -v unzip >/dev/null 2>&1 || nibras-need unzip
  bytes=$(wc -c < "$t" | tr -d ' ')
  echo "$(basename "$t")  zip $bytes bytes"
  unzip -l "$t" | awk -v zip="$bytes" '
    function human(n,    i, u) {
      split("B KB MB GB", u, " ")
      i = 1
      while (n >= 1024 && i < 4) { n /= 1024; i++ }
      return sprintf("%.1f %s", n, u[i])
    }
    function bucket(name) {
      if (name ~ /(^|\/)classes[0-9]*\.dex$/ || name ~ /\.dex$/) return "dex"
      if (name ~ /^lib\//) return "native"
      if (name ~ /^res\// || name == "resources.arsc" || name ~ /\.arsc$/) return "resources"
      if (name ~ /^assets\//) return "assets"
      if (name == "AndroidManifest.xml") return "manifest"
      if (name ~ /^META-INF\//) return "meta"
      if (name ~ /^kotlin\//) return "kotlin"
      return "other"
    }
    NR < 4 { next }
    /^----/ { next }
    {
      if ($1 !~ /^[0-9]+$/) next
      name = $0
      sub(/^ *[0-9]+ +[0-9-]+ +[0-9:]+ +/, "", name)
      if (name == "" || name ~ /files?$/) next
      len = $1 + 0
      b = bucket(name)
      sum[b] += len
      total += len
      nfiles++
      names[nfiles] = name
      sizes[nfiles] = len
    }
    END {
      order[1]="dex"; order[2]="resources"; order[3]="native"; order[4]="assets"
      order[5]="manifest"; order[6]="kotlin"; order[7]="meta"; order[8]="other"
      print "uncompressed " human(total)
      for (i = 1; i <= 8; i++) {
        k = order[i]
        v = sum[k] + 0
        pct = (total > 0) ? (100 * v / total) : 0
        printf "  %-12s %10s   %5.1f%%\n", k, human(v), pct
      }
      print "largest"
      m = nfiles + 0
      for (a = 1; a <= m; a++) rank[a] = a
      for (a = 1; a <= m; a++) for (b = a + 1; b <= m; b++) if (sizes[rank[b]] > sizes[rank[a]]) { t = rank[a]; rank[a] = rank[b]; rank[b] = t }
      limit = (m < 12) ? m : 12
      for (a = 1; a <= limit; a++) printf "  %10s  %s\n", human(sizes[rank[a]]), names[rank[a]]
      printf "zip file %s\n", human(zip + 0)
    }
  '
}
res_dir_of() {
  d="${1:-.}"
  if [ -d "$d/app/src/main" ] || [ -f "$d/app/build.gradle" ] || [ -f "$d/app/build.gradle.kts" ]; then
    mkdir -p "$d/app/src/main/res"
    printf '%s\n' "$d/app/src/main/res"
    return 0
  fi
  if [ -d "$d/res" ]; then printf '%s\n' "$d/res"; return 0; fi
  if [ -f "$d/AndroidManifest.xml" ]; then mkdir -p "$d/res"; printf '%s\n' "$d/res"; return 0; fi
  if [ -d "$d" ]; then printf '%s\n' "$d"; return 0; fi
  echo "no project directory: $d" >&2
  return 1
}
write_adaptive() {
  res="$1"
  mkdir -p "$res/mipmap-anydpi-v26"
  for n in ic_launcher ic_launcher_round; do
    cat > "$res/mipmap-anydpi-v26/$n.xml" <<'XML'
<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
XML
  done
}
scale_magick() {
  src="$1"; px="$2"; out="$3"
  mkdir -p "$(dirname "$out")"
  if command -v magick >/dev/null 2>&1; then
    magick "$src" -resize "${px}x${px}^" -gravity center -extent "${px}x${px}" "PNG32:$out"
  else
    convert "$src" -resize "${px}x${px}^" -gravity center -extent "${px}x${px}" "PNG32:$out"
  fi
}
png_icons() {
  python3 - "$1" "$2" <<'PY'
import struct, sys, zlib
src, root = sys.argv[1], sys.argv[2]
data = open(src, "rb").read()
if data[:8] != b"\x89PNG\r\n\x1a\n":
    sys.exit(2)
pos, w, h, color, depth, inter = 8, 0, 0, 0, 0, 0
idat = b""
while pos + 8 <= len(data):
    ln, typ = struct.unpack(">I4s", data[pos:pos+8])
    chunk = data[pos+8:pos+8+ln]
    pos += 12 + ln
    if typ == b"IHDR":
        w, h, depth, color, _, _, inter = struct.unpack(">IIBBBBB", chunk[:13])
    elif typ == b"IDAT":
        idat += chunk
    elif typ == b"IEND":
        break
if inter or depth != 8 or color not in (2, 6):
    sys.exit(3)
bpp = 4 if color == 6 else 3
raw = zlib.decompress(idat)
rows, i, prev = [], 0, bytearray(w * bpp)
def paeth(a, b, c):
    p = a + b - c
    pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
