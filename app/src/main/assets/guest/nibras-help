#!/bin/sh
# help: banner, localized command list, and the command names in your language.
cat /etc/nibras/banner /etc/nibras/help 2>/dev/null
L=${NIBRAS_LANG:-$(cat /etc/nibras/lang 2>/dev/null)}
[ -n "$L" ] && [ "$L" != en ] || exit 0
list=$(NIBRAS_LANG=$L nibras-alias --list "$L")
[ -n "$list" ] || exit 0
. /usr/local/share/nibras/msg.sh 2>/dev/null
title=$(nibras_i18n "Commands in your language (English names work too):" 2>/dev/null)
case "$L" in az) title="Öz dilində əmrlər (ingiliscə adlar da işləyir):" ;; tr) title="Kendi dilinde komutlar (İngilizce adlar da çalışır):" ;; ru) title="Команды на вашем языке (английские тоже работают):" ;; esac
printf '\n\033[1;33m%s\033[0m\n' "${title:-Commands in your language (English names work too):}"
printf '%s\n' "$list" | awk -F'\t' '{printf "  \033[1;32m%s\033[0m → %s\n", $1, $2}'
