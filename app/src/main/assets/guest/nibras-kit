  if has "$c"; then "$c" --help 2>&1 | head -40; else say "Unknown command. install? → install $c" "Naməlum əmr. Qurmaq: pkg install $c" "Bilinmeyen komut: pkg install $c" "Неизвестная команда: pkg install $c"; fi
}
# Error → fix suggestions (Nibras-only). Reads the error text and proposes the command that fixes it.
fix_suggest() {
  e=$1; cmdline=$2
  hint() { printf '  \033[1;32m→ %s\033[0m\n' "$1"; }
  m=$(printf '%s' "$e" | sed -n "s/.*No module named '\([A-Za-z0-9_.-]*\)'.*/\1/p" | head -1); [ -n "$m" ] && hint "pip3 install ${m%%.*}"
  m=$(printf '%s' "$e" | sed -n "s/.*Cannot find module '\([^']*\)'.*/\1/p" | head -1); [ -n "$m" ] && case "$m" in .*|/*) ;; *) hint "npm install $m" ;; esac
  m=$(printf '%s' "$e" | sed -n 's/.*fatal error: \([A-Za-z0-9_./+-]*\.h\).*/\1/p' | head -1); [ -n "$m" ] && hint "pkg search ${m%.h}   (dev package: -dev / -devel / -headers)"
  printf '%s' "$e" | grep -q "externally-managed-environment" && hint "python3 -m venv .venv && . .venv/bin/activate   ($(say or or veya или) pip3 install --break-system-packages …)"
  printf '%s' "$e" | grep -qi "permission denied" && { f=$(printf '%s' "$cmdline" | awk '{print $1}'); [ -f "$f" ] && hint "chmod +x $f"; printf '%s' "$e" | grep -q "/sdcard\|/storage" && hint "nibras-setup-storage"; }
  printf '%s' "$e" | grep -qiE "could not resolve|temporary failure in name resolution|network is unreachable" && hint "$(say "check Wi-Fi / mobile data, then: net ping 1.1.1.1" "Wi-Fi / mobil interneti yoxla, sonra: net ping 1.1.1.1" "Wi-Fi / mobil veriyi kontrol et: net ping 1.1.1.1" "проверьте сеть: net ping 1.1.1.1")"
  printf '%s' "$e" | grep -qi "no space left" && hint "pkg clean; trash empty; du -sh ~/* | sort -h | tail"
  printf '%s' "$e" | grep -qi "address already in use" && hint "$(say "port is busy: use another port, or find it: netstat -tlnp" "port məşğuldur: başqa port seç, ya da tap: netstat -tlnp" "port meşgul: netstat -tlnp" "порт занят: netstat -tlnp")"
  printf '%s' "$e" | grep -qi "not a git repository" && hint "git init"
  printf '%s' "$e" | grep -qiE "could not get lock|unable to lock|database is locked" && hint "$(say "another package install is running; wait, or: rm -f /var/lib/dpkg/lock* /var/lib/pacman/db.lck" "başqa quraşdırma gedir; gözlə, ya da: rm -f /var/lib/dpkg/lock* /var/lib/pacman/db.lck" "başka kurulum sürüyor; bekle" "идёт другая установка; подождите")"
  printf '%s' "$e" | grep -qiE "unable to locate package|target not found|no match for argument|no such package" && hint "pkg search $(printf '%s' "$cmdline" | awk '{print $NF}')"
  printf '%s' "$e" | grep -qiE "command not found|not found$" && { m=$(printf '%s' "$e" | sed -n 's/.*: \([A-Za-z0-9_.+-]*\): \{0,1\}\(command \)\{0,1\}not found.*/\1/p' | head -1); [ -n "$m" ] && hint "pkg install $m"; }
  printf '%s' "$e" | grep -qi "SSL\|certificate" && hint "pkg install ca-certificates"
  printf '%s' "$e" | grep -qi "killed" && hint "$(say "out of memory: close apps or use a smaller model / -j1" "yaddaş bitdi: tətbiqləri bağla ya da -j1" "bellek bitti: -j1" "нехватка памяти: -j1")"
  true
}

cmd_fix() { # suggest a fix for a missing / mistyped command, or for the error of a command
  case "${1:-}" in
    "")
      h=${HISTFILE:-$HOME/.ash_history}; [ -f "$h" ] || h=$HOME/.bash_history
      last=$(grep -v '^fix$\|^nibras-kit fix' "$h" 2>/dev/null | tail -1)
      [ -n "$last" ] || { echo "fix <command> · fix -- <command line> · <command> 2>&1 | fix -"; return; }
      say "Re-running to read the error: $last" "Xətanı oxumaq üçün yenidən işlədirəm: $last" "Hatayı okumak için tekrar: $last" "Повтор для анализа ошибки: $last"
      set -- -- "$last" ;;
  esac
  if [ "$1" = - ]; then e=$(cat); fix_suggest "$e" ""; return 0; fi
  if [ "$1" = -- ]; then shift; line="$*"; e=$(sh -c "$line" 2>&1 >/dev/null </dev/null); rc=$?
    [ $rc -eq 0 ] && { say "It worked this time (exit 0)." "Bu dəfə işlədi (exit 0)." "Bu sefer çalıştı." "Сработало (exit 0)."; return 0; }
    printf '%s\n' "$e" | tail -5; fix_suggest "$e" "$line"; return $rc; fi
  c=${1:-}
  printf '\033[33m%s\033[0m\n' "$(say "Command not found: $c" "Əmr tapılmadı: $c" "Komut bulunamadı: $c" "Команда не найдена: $c")"
  if pack_desc "$c" >/dev/null 2>&1; then echo "  → install $c"; return 127; fi
  best=$(for d in $(echo "$PATH" | tr ':' ' '); do ls "$d" 2>/dev/null; done | sort -u | awk -v w="$c" '
    function dist(a,b,  i,j,la,lb,d,c1,x,y,z){la=length(a);lb=length(b);for(i=0;i<=la;i++)d[i,0]=i;for(j=0;j<=lb;j++)d[0,j]=j
      for(i=1;i<=la;i++)for(j=1;j<=lb;j++){c1=(substr(a,i,1)==substr(b,j,1))?0:1;x=d[i-1,j]+1;y=d[i,j-1]+1;z=d[i-1,j-1]+c1;d[i,j]=(x<y?(x<z?x:z):(y<z?y:z))}return d[la,lb]}
    length($0)>1 && (dd=dist(w,$0))<=2 {print dd, $0}' | sort -n | head -3 | awk '{print $2}')
  [ -n "$best" ] && for b in $best; do printf '  → %s\n' "$b"; done
  printf '  → pkg install %s\n' "$c"
  return 127
}

