  lesson 3 "mkdir creates a folder." "mkdir qovluq yaradır." "mkdir klasör oluşturur." "mkdir создаёт папку." "$(say 'Create folder test' 'test qovluğu yarat' 'test klasörü oluştur' 'Создай папку test')" '^mkdir (-p )?test$'
  lesson 4 "echo prints text; > writes it into a file." "echo mətn yazır; > onu fayla yazır." "echo metin yazar; > dosyaya yazar." "echo выводит текст; > пишет в файл." "$(say 'Write hello into test/a.txt' 'test/a.txt faylına salam yaz' 'test/a.txt dosyasına merhaba yaz' 'Запиши hello в test/a.txt')" '^echo .+ > ?test/a\.txt$'
  lesson 5 "cat shows a file." "cat faylı göstərir." "cat dosyayı gösterir." "cat показывает файл." "$(say 'Show test/a.txt' 'test/a.txt-ni göstər' 'test/a.txt göster' 'Покажи test/a.txt')" '^cat test/a\.txt$'
  lesson 6 "cp copies, mv moves/renames." "cp kopyalayır, mv köçürür/adını dəyişir." "cp kopyalar, mv taşır/yeniden adlandırır." "cp копирует, mv перемещает." "$(say 'Copy test/a.txt to test/b.txt' 'test/a.txt-ni test/b.txt-yə kopyala' 'test/a.txt dosyasını test/b.txt olarak kopyala' 'Скопируй в test/b.txt')" '^cp test/a\.txt test/b\.txt$'
  lesson 7 "grep finds text inside files." "grep fayllarda mətn axtarır." "grep dosyalarda metin arar." "grep ищет текст в файлах." "$(say 'Find hello/salam in test/' 'test/ içində axtar' 'test/ içinde ara' 'Найди текст в test/')" '^grep (-r |-ri |-rn )?[^ ]+ test'
  lesson 8 "| sends output of one command to another." "| bir əmrin çıxışını digərinə ötürür." "| bir komutun çıktısını diğerine aktarır." "| передаёт вывод другой команде." "$(say 'Count files: ls | wc -l' 'Faylları say: ls | wc -l' 'Dosyaları say: ls | wc -l' 'Посчитай файлы: ls | wc -l')" '^ls.*\| ?wc -l$'
  lesson 9 "rm -r deletes (careful!). In Nibras, trash is safer." "rm -r silir (diqqət!). Nibras-da trash daha təhlükəsizdir." "rm -r siler (dikkat!). Nibras'ta trash daha güvenli." "rm -r удаляет (осторожно!). trash безопаснее." "$(say 'Move test to trash' 'test-i zibil qutusuna at' 'test klasörünü çöpe at' 'Отправь test в корзину')" '^(trash|rm -r) test/?$'
  lesson 10 "install adds tools. Try a pack name." "install alət əlavə edir. Paket adını yoxla." "install araç ekler." "install добавляет инструменты." "$(say 'List packs' 'Paketləri göstər' 'Paketleri göster' 'Покажи пакеты')" '^(install|nibras install)$'
  quiz
}
quiz() {
  printf '\n\033[1;35mQuiz\033[0m\n'; score=0
  q() { a=$(ask_in "$1"); if printf '%s' "$a" | grep -Eqi "$2"; then score=$((score+1)); echo "✓"; else echo "✗ → $3"; fi; }
  q "$(say 'Command to show current folder?' 'Hazırkı qovluğu göstərən əmr?' 'Mevcut klasörü gösteren komut?' 'Команда текущей папки?')" '^pwd$' pwd
  q "$(say 'Show hidden files?' 'Gizli faylları göstər?' 'Gizli dosyaları göster?' 'Показать скрытые?')" '^ls -[a-z]*a' 'ls -la'
  q "$(say 'Search text in files?' 'Fayllarda mətn axtar?' 'Dosyalarda metin ara?' 'Поиск текста?')" '^grep' grep
