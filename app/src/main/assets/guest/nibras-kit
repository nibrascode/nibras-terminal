glibc_only() { is_alpine && die "$(say "$1 needs a glibc environment: install debian (or ubuntu), then run it there." "$1 glibc mühiti tələb edir: install debian (və ya ubuntu), sonra orada işlədin." "$1 glibc ortamı ister: install debian (veya ubuntu), sonra orada çalıştırın." "$1 нужна среда glibc: install debian (или ubuntu) и запускайте там.")"; return 0; }
fetch_to() { curl -fL --retry 3 -o "$2" "$1" || die "download failed: $1"; }
install_pack() {
  p=$1
  case "$p" in
    arch|fedora|kali|debian|ubuntu)
      case "$p:$(uname -m)" in
        fedora:armv7l|fedora:armv8l|fedora:arm) die "$(say "Fedora has no 32-bit ARM build since Fedora 37; use Debian, Arch or Kali." "Fedora-nın 37-dən sonra 32-bit ARM versiyası yoxdur; Debian, Arch ya da Kali seç." "Fedora 37'den beri 32-bit ARM sürümü yok; Debian, Arch veya Kali seç." "У Fedora нет 32-битной ARM-сборки с версии 37; выберите Debian, Arch или Kali.")" ;;
      esac
      nibras-api env-install "$p"; return ;;
    lsp) lsp_install ;;
    typescript) need node npm; npm install -g typescript tsx ;;
    dart) has dart && return 0; glibc_only Dart; case "$(uname -m)" in aarch64) a=arm64 ;; *) a=arm ;; esac
      need unzip; fetch_to "https://storage.googleapis.com/dart-archive/channels/stable/release/latest/sdk/dartsdk-linux-$a-release.zip" /tmp/dart.zip
      rm -rf /opt/dart-sdk; unzip -q /tmp/dart.zip -d /opt && rm -f /tmp/dart.zip && ln -sf /opt/dart-sdk/bin/dart /usr/local/bin/dart && dart --version ;;
    r) nibras-need Rscript ;;
    julia) has julia && return 0; glibc_only Julia; [ "$(uname -m)" = aarch64 ] || die "Julia: arm64 only"
      fetch_to https://julialang-s3.julialang.org/bin/linux/aarch64/1.11/julia-1.11.2-linux-aarch64.tar.gz /tmp/julia.tgz
      rm -rf /opt/julia-1.11.2; tar -xzf /tmp/julia.tgz -C /opt && rm -f /tmp/julia.tgz && ln -sf /opt/julia-1.11.2/bin/julia /usr/local/bin/julia && julia --version ;;
    haskell) nibras-need ghc && { has runghc || nibras-need runghc >/dev/null 2>&1 || true; } ;;
    elixir) nibras-need elixir ;;
    zig) has zig && return 0; case "$(uname -m)" in aarch64) a=aarch64 ;; *) a=armv7a ;; esac
      need xz; fetch_to "https://ziglang.org/download/0.13.0/zig-linux-$a-0.13.0.tar.xz" /tmp/zig.txz
      rm -rf /opt/zig; mkdir -p /opt/zig && tar -xJf /tmp/zig.txz -C /opt/zig --strip-components=1 && rm -f /tmp/zig.txz && ln -sf /opt/zig/zig /usr/local/bin/zig && zig version ;;
