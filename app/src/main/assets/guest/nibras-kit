    java) nibras-apk jdk; nibras-need mvn >/dev/null 2>&1 || nibras-need maven >/dev/null 2>&1 || true; nibras-need kotlin >/dev/null 2>&1 || nibras-need kotlinc >/dev/null 2>&1 || true ;;
