video subs in.mp4 subs.srt             $(say "burn subtitles" "altyazı əlavə et" "altyazı göm" "вшить субтитры")
EOF
      return ;;
  esac
  need ffmpeg
  o=$(outdir)
  case "$a" in
    merge|join)
      [ $# -ge 2 ] || die "video merge a.mp4 b.mp4 [out.mp4]"
      last=$(eval echo "\${$#}"); out=; case "$last" in *.mp4|*.mkv|*.mov|*.webm) [ -e "$last" ] || out=$last ;; esac
      list=$(mktemp); n=0
      for f in "$@"; do [ "$f" = "$out" ] && continue; printf "file '%s'\n" "$(readlink -f "$f")" >> "$list"; n=$((n+1)); done
      out=${out:-$o/merged-$(date +%H%M%S).mp4}
      run ffmpeg -hide_banner -f concat -safe 0 -i "$list" -c copy "$out" || {
        say "Different formats — re-encoding…" "Formatlar fərqlidir — yenidən kodlanır…" "Formatlar farklı — yeniden kodlanıyor…" "Разные форматы — перекодирование…"
        run ffmpeg -hide_banner -y -f concat -safe 0 -i "$list" -c:v libx264 -preset veryfast -crf 23 -c:a aac "$out"; }
      rm -f "$list"; echo "→ $out" ;;
    cut|trim) [ $# -ge 3 ] || die "video cut in.mp4 START END"; out=$o/cut-$(basename "$1"); run ffmpeg -hide_banner -y -ss "$2" -to "$3" -i "$1" -c copy "$out"; echo "→ $out" ;;
    convert) [ $# -ge 2 ] || die "video convert in out.ext"; run ffmpeg -hide_banner -y -i "$1" "$2" ;;
    compress) out=$o/small-$(basename "${1%.*}").mp4; run ffmpeg -hide_banner -y -i "$1" -c:v libx264 -preset veryfast -crf "${2:-28}" -c:a aac -b:a 96k "$out"
      echo "→ $out ($(du -h "$1" | cut -f1) → $(du -h "$out" | cut -f1))" ;;
    audio|mp3) ext=${2:-mp3}; out=$o/$(basename "${1%.*}").$ext; run ffmpeg -hide_banner -y -i "$1" -vn "$out"; echo "→ $out" ;;
    gif) out=$o/$(basename "${1%.*}").gif; run ffmpeg -hide_banner -y -ss "${2:-0}" -t "${3:-5}" -i "$1" -vf "fps=12,scale=480:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse" "$out"; echo "→ $out" ;;
    resize) out=$o/${2:-720}p-$(basename "$1"); run ffmpeg -hide_banner -y -i "$1" -vf "scale=-2:${2:-720}" -c:a copy "$out"; echo "→ $out" ;;
    rotate) case "${2:-90}" in 90) vf=transpose=1 ;; 180) vf="transpose=1,transpose=1" ;; 270) vf=transpose=2 ;; *) die "90|180|270" ;; esac
      out=$o/rot-$(basename "$1"); run ffmpeg -hide_banner -y -i "$1" -vf "$vf" -c:a copy "$out"; echo "→ $out" ;;
    mute) out=$o/mute-$(basename "$1"); run ffmpeg -hide_banner -y -i "$1" -an -c:v copy "$out"; echo "→ $out" ;;
    speed) s=${2:-2}; out=$o/x$s-$(basename "$1"); run ffmpeg -hide_banner -y -i "$1" -filter_complex "[0:v]setpts=PTS/$s[v];[0:a]atempo=$s[a]" -map "[v]" -map "[a]" "$out"; echo "→ $out" ;;
    frames) d=$o/frames-$(basename "${1%.*}"); mkdir -p "$d"; run ffmpeg -hide_banner -i "$1" -vf fps="${2:-1}" "$d/%04d.jpg"; echo "→ $d" ;;
    subs) out=$o/subs-$(basename "$1"); run ffmpeg -hide_banner -y -i "$1" -vf "subtitles=$2" -c:a copy "$out"; echo "→ $out" ;;
    info) need ffprobe; ffprobe -hide_banner "$1" ;;
    *) die "video help" ;;
  esac
}

