# ---------------------------------------------------------------- backup / snapshot
cmd_backup() {
  a=${1:-help}; [ $# -gt 0 ] && shift; o=$(outdir)/backups; mkdir -p "$o"
  case "$a" in
    help) echo "backup home · backup <folder> · backup list · backup restore <file.tar.gz> · backup sync <src> <dst> (rsync) · backup cloud (rclone config)"; ;;
    home) out=$o/home-$(date +%F-%H%M).tar.gz; run tar -czf "$out" -C / --exclude=root/storage --exclude=root/.cache root; echo "→ $out" ;;
    list) ls -lh "$o" ;;
    restore) run tar -xzf "$1" -C / ;;
    sync) need rsync; run rsync -avh --progress "$1" "$2" ;;
    cloud) need rclone; rclone config ;;
    *) d=$(readlink -f "$a"); out=$o/$(basename "$d")-$(date +%F-%H%M).tar.gz; run tar -czf "$out" -C "$(dirname "$d")" "$(basename "$d")"; echo "→ $out" ;;
  esac
}
cmd_snapshot() {
  a=${1:-help}; [ $# -gt 0 ] && shift; o=$(outdir)/snapshots; mkdir -p "$o"
  case "$a" in
    help) echo "snapshot save [name] · snapshot list · snapshot restore <name>   ($(say "whole Linux environment" "bütün Linux mühiti" "tüm Linux ortamı" "всё окружение"))" ;;
    save) out=$o/${1:-$(. /etc/os-release; echo "$ID")-$(date +%F-%H%M)}.tar.gz
      say "Saving the environment…" "Mühit saxlanılır…" "Ortam kaydediliyor…" "Сохранение окружения…"
      tar -czf "$out" -C / --exclude=proc --exclude=sys --exclude=dev --exclude=sdcard --exclude=storage --exclude=tmp \
        --exclude=root/storage --exclude=var/cache --one-file-system . 2>/dev/null; echo "→ $out ($(du -h "$out" | cut -f1))" ;;
    list) ls -lh "$o" ;;
    restore) f=$o/${1%.tar.gz}.tar.gz; [ -f "$f" ] || f=$1; [ -f "$f" ] || die "?"
      c=$(ask_in "$(say "Overwrite the environment with $f? (yes)" "Mühit $f ilə əvəz olunsun? (yes)" "Ortam $f ile değiştirilsin mi? (yes)" "Перезаписать окружение? (yes)")")
      [ "$c" = yes ] && tar -xzf "$f" -C / && say "Done. Open a new session." "Hazırdır. Yeni sessiya aç." "Tamam. Yeni oturum aç." "Готово. Откройте новую сессию." ;;
  esac
}

# ---------------------------------------------------------------- net / share / webterm / qr
cmd_net() {
  a=${1:-help}; [ $# -gt 0 ] && shift
  case "$a" in
    help) echo "net ip · net scan · net ports <host> · net ping <host> · net speed · net dns <name> · net trace <host> · net whois <domain> · net get <url>" ;;
    ip) echo "local: $(ip_addr)"; need curl; echo "public: $(curl -fsS https://api.ipify.org)"; nibras-wifi-connectioninfo 2>/dev/null | head -12 ;;
    scan) need nmap; ip=$(ip_addr); run nmap -sn "${1:-${ip%.*}.0/24}" ;;
    ports) need nmap; run nmap -F "$@" ;;
    ping) need ping; run ping -c 5 "$@" ;;
    speed) if nibras-need speedtest-cli >/dev/null 2>&1; then speedtest-cli --simple; else need curl
      curl -o /dev/null -w "download: %{speed_download} B/s\n" -s https://speed.cloudflare.com/__down?bytes=25000000; fi ;;
    dns) need dig; dig +short "$@" ;;
    trace) need traceroute; traceroute "$@" ;;
    whois) need whois; whois "$@" ;;
    get) need curl; curl -fsSL "$@" ;;
    *) die "net help" ;;
  esac
}
cmd_share() {
  a=${1:-help}; [ $# -gt 0 ] && shift
  [ "$a" = help ] && { echo "share webdav|ftp|http|dlna|sftp|smb [folder] [port]  ·  share file <file>"; return; }
  if [ "$a" = smb ]; then
    # Samba. Android blocks ports below 1024 without root, so the default port is 4445 (root phones: 445).
    need smbd 2>/dev/null || nibras-need samba; d=${1:-/sdcard}; ip=$(ip_addr); port=${2:-4445}; [ "$(id -u)" = 0 ] && [ -e /system/xbin/su ] && port=${2:-445}
    pw=$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n'); conf=/tmp/nibras-smb.conf
    printf '[global]\n server role = standalone server\n smb ports = %s\n map to guest = never\n disable netbios = yes\n server min protocol = SMB2\n pid directory = /tmp\n lock directory = /tmp\n state directory = /tmp\n cache directory = /tmp\n private dir = /tmp\n[nibras]\n path = %s\n read only = no\n force user = root\n' "$port" "$d" > "$conf"
    (echo "$pw"; echo "$pw") | smbpasswd -c "$conf" -s -a root >/dev/null 2>&1
    echo "smb://$ip:$port/nibras   user: root   password: $pw"
    say "Windows needs port 445 (root only); Android/Linux/macOS file managers accept smb://ip:port." "Windows 445-ci port istəyir (yalnız root); Android/Linux/macOS fayl menecerləri smb://ip:port qəbul edir." "Windows 445 portu ister (sadece root); Android/Linux/macOS smb://ip:port kabul eder." "Windows нужен порт 445 (только root); Android/Linux/macOS принимают smb://ip:port."
    has qrencode && qrencode -t ansiutf8 "smb://$ip:$port/nibras"
    exec smbd -F --no-process-group -s "$conf" --debug-stdout
  fi
  need rclone; ip=$(ip_addr)
  case "$a" in
    file) need python3; f=$(readlink -f "$1"); port=8765; url="http://$ip:$port/$(basename "$f")"; echo "$url"; has qrencode || nibras-need qrencode; qrencode -t ansiutf8 "$url"
      cd "$(dirname "$f")" && exec python3 -m http.server $port ;;
  esac
  d=${1:-/sdcard}; port=${2:-8081}; pw=$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n')
  url="$a://$ip:$port"; [ "$a" = webdav ] && url="http://$ip:$port"; [ "$a" = http ] && url="http://$ip:$port"
  echo "$url   user: nibras   password: $pw"; has qrencode && qrencode -t ansiutf8 "$url"
  case "$a" in
    webdav|http|ftp|sftp) exec rclone serve "$a" "$d" --addr "0.0.0.0:$port" --user nibras --pass "$pw" ;;
    dlna) exec rclone serve dlna "$d" --addr "0.0.0.0:$port" --name "Nibras" ;;
    *) die "share help" ;;
  esac
}
cmd_webterm() {
  need ttyd; ip=$(ip_addr); port=${1:-7681}; pw=$(head -c 6 /dev/urandom | od -An -tx1 | tr -d ' \n')
  say "Open on your computer (same Wi-Fi):" "Kompüterdə aç (eyni Wi-Fi):" "Bilgisayarda aç (aynı Wi-Fi):" "Откройте на компьютере (тот же Wi-Fi):"
  echo "  http://$ip:$port   user: nibras   password: $pw"; has qrencode && qrencode -t ansiutf8 "http://$ip:$port"
  exec ttyd -W -p "$port" -c "nibras:$pw" -t fontSize=15 -t titleFixed="Nibras Terminal" "${SHELL:-/bin/sh}" -l
}
cmd_qr() {
  has qrencode || need qrencode
  if [ $# -eq 0 ] && [ ! -t 0 ]; then qrencode -t ansiutf8; elif [ -f "${1:-}" ]; then cmd_share file "$1"; else qrencode -t ansiutf8 "$*"; fi
}

# ---------------------------------------------------------------- ocr / llm / quran / prayer
cmd_ocr() {
  [ -n "${1:-}" ] && [ "$1" != help ] || { echo "ocr photo.jpg [aze+eng|tur|rus|ara]  ·  ocr file.pdf"; return; }
  need tesseract; f=$1; lang=${2:-}
  [ -z "$lang" ] && case "$L" in az) lang=aze+eng ;; tr) lang=tur+eng ;; ru) lang=rus+eng ;; *) lang=eng ;; esac
  tesseract --list-langs 2>/dev/null | grep -q "^${lang%%+*}$" || lang=eng
  o=$(outdir); out=$o/$(basename "${f%.*}")
  case "$f" in
    *.pdf) need pdftoppm; t=$(mktemp -d); pdftoppm -r 200 -png "$f" "$t/p"; : > "$out.txt"
      for p in "$t"/p*.png; do tesseract "$p" - -l "$lang" 2>/dev/null >> "$out.txt"; done; rm -rf "$t" ;;
    *) tesseract "$f" "$out" -l "$lang" 2>/dev/null ;;
  esac
  cat "$out.txt"; echo "→ $out.txt"
}
LLM_DIR=/opt/nibras-llm
llm_setup() {
  [ -x $LLM_DIR/llama-cli ] && [ -f $LLM_DIR/model.gguf ] && return 0
  need git cmake g++ make curl
  mkdir -p $LLM_DIR; cd $LLM_DIR || exit 1
  if [ ! -x llama-cli ]; then
    say "Building llama.cpp (10–40 min on a phone)…" "llama.cpp yığılır (telefonda 10–40 dəq)…" "llama.cpp derleniyor (10–40 dk)…" "Сборка llama.cpp (10–40 мин)…"
    [ -d src ] || git clone --depth 1 https://github.com/ggml-org/llama.cpp src || die "git"
    cmake -S src -B build -DLLAMA_CURL=OFF -DGGML_NATIVE=OFF -DCMAKE_BUILD_TYPE=Release >/dev/null && cmake --build build -j"$(nproc)" --target llama-cli || die "build"
    cp build/bin/llama-cli llama-cli
  fi
  if [ ! -f model.gguf ]; then
    say "Downloading a small multilingual model (~400 MB)…" "Kiçik çoxdilli model yüklənir (~400 MB)…" "Küçük çok dilli model indiriliyor (~400 MB)…" "Загрузка модели (~400 МБ)…"
    curl -fL -C - -o model.gguf.part "https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf" && mv model.gguf.part model.gguf
  fi
}
cmd_llm() {
  case "${1:-chat}" in
    help) echo "llm · llm \"question\" · llm model <url.gguf>"; return ;;
    model) curl -fL -o $LLM_DIR/model.gguf "$2"; return ;;
  esac
  llm_setup || exit 1
  if [ $# -gt 0 ] && [ "$1" != chat ]; then exec $LLM_DIR/llama-cli -m $LLM_DIR/model.gguf -p "$*" -n 400 --no-display-prompt -no-cnv 2>/dev/null; fi
  exec $LLM_DIR/llama-cli -m $LLM_DIR/model.gguf -cnv --color 2>/dev/null
}
cmd_quran() {
  need curl jq; a=${1:-help}
  case "$L" in az) ed=az.mammadaliyev ;; tr) ed=tr.diyanet ;; ru) ed=ru.kuliev ;; *) ed=en.sahih ;; esac
  case "$a" in
    help) echo "quran 2:255 · quran 1 (surah) · quran random · quran search <word> · hadith [bukhari|muslim] [n]"; ;;
    random) n=$(( $(od -An -N2 -tu2 /dev/urandom) % 6236 + 1 )); cmd_quran "$n" ;;
    search) shift; curl -fsS "https://api.alquran.cloud/v1/search/$(printf %s "$*" | jq -sRr @uri)/all/$ed" | jq -r '.data.matches[:10][]|"\(.surah.number):\(.numberInSurah)  \(.text)"' ;;
    *:*) curl -fsS "https://api.alquran.cloud/v1/ayah/$a/editions/quran-uthmani,$ed" | jq -r '.data[]|.text' ; echo "($a)" ;;
    *) case "$a" in *[!0-9]*) die "quran help" ;; esac
       if [ "$a" -le 114 ]; then curl -fsS "https://api.alquran.cloud/v1/surah/$a/$ed" | jq -r '.data.englishName as $n|"— \($n) —", (.data.ayahs[]|"\(.numberInSurah). \(.text)")' | ${PAGER:-less -R} 2>/dev/null || cat
       else curl -fsS "https://api.alquran.cloud/v1/ayah/$a/editions/quran-uthmani,$ed" | jq -r '.data[]|.text'; fi ;;
  esac
}
cmd_hadith() {
  need curl jq; book=${1:-bukhari}; n=${2:-$(( $(od -An -N2 -tu2 /dev/urandom) % 7000 + 1 ))}
  case "$L" in tr) lang=tur ;; ru) lang=rus ;; *) lang=eng ;; esac
  curl -fsS "https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1/editions/$lang-$book/$n.json" | jq -r '.hadiths[0].text // empty' || curl -fsS "https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@1/editions/eng-$book/$n.json" | jq -r '.hadiths[0].text'
  echo "($book $n)"
}
cmd_prayer() {
  need curl jq; conf=$HOME/.config/nibras/prayer; mkdir -p "${conf%/*}"
  a=${1:-today}
  case "$a" in
    help) echo "prayer · prayer city Baku [Azerbaijan] [method] · prayer remind on|off|status|test|before 10"; return ;;
    city) shift; printf 'CITY=%s\nCOUNTRY=%s\nMETHOD=%s\n' "$1" "${2:-}" "${3:-13}" > "$conf"; a=today ;;
  esac
  [ -f "$conf" ] && . "$conf"; CITY=${CITY:-Baku}; COUNTRY=${COUNTRY:-Azerbaijan}
  case "$a" in
    remind)
      # Android alarms: fire even when Nibras is closed (opt-in). method: 13 = Diyanet, 3 = MWL, 4 = Umm al-Qura, 2 = ISNA, 5 = Egypt, 7 = Tehran
      crontab -l 2>/dev/null | grep -q nibras-prayer && crontab -l 2>/dev/null | grep -v nibras-prayer | crontab -
      case "${2:-on}" in
        off) nibras-api prayer-alarm off ;;
        status) nibras-api prayer-alarm status ;;
        test) nibras-api prayer-alarm test ;;
        before) nibras-api prayer-alarm before "${3:-10}" ;;
        *) nibras-api prayer-alarm on "$CITY" "$COUNTRY" "${METHOD:-13}" ;;
      esac ;;
    *) curl -fsS "https://api.aladhan.com/v1/timingsByCity?city=$CITY&country=$COUNTRY" | jq -r --arg c "$CITY" '.data|"\($c) · \(.date.readable) · \(.date.hijri.date)", (.timings|to_entries[]|select(.key|test("Fajr|Sunrise|Dhuhr|Asr|Maghrib|Isha"))|"  \(.key)\t\(.value)")' ;;
  esac
}

