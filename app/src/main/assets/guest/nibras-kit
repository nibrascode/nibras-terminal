cmd_ask() {
  [ $# -gt 0 ] || { say 'ask "how do I merge videos"' 'ask "videoları necə birləşdirim"' 'ask "videoları nasıl birleştiririm"' 'ask "как склеить видео"'; return; }
  q=$(printf '%s' "$*" | tr 'A-Z' 'a-z'); found=0
  printf '%s\n' "$RECIPES" | while IFS= read -r line; do
    keys=${line%|*}; cmd=${line##*|}; old=$IFS; IFS='|'
    for k in $keys; do case "$q" in *"$k"*) printf '  \033[1;32m%s\033[0m\n' "$cmd"; break ;; esac; done; IFS=$old
  done | awk '!s[$0]++' | head -6 | grep . || { say "No recipe yet. Try: explain <command>, or llm \"$*\"" "Resept tapılmadı. Yoxla: explain <əmr>, ya da llm \"$*\"" "Tarif yok. Dene: explain <komut> veya llm \"$*\"" "Нет рецепта. Попробуйте explain или llm"; }
}
cmd_recipes() { printf '%s\n' "$RECIPES" | awk -F'|' '{print "  " $NF}' | awk '!s[$0]++'; }
cmd_explain() {
  [ $# -gt 0 ] || { echo "explain <command>   (tldr pages: en/tr/ru…)"; return; }
  c=$1
  if ! has tldr; then need python3 pip3; pip3 install -q tldr --break-system-packages 2>/dev/null || pip3 install -q tldr; fi
  lang=$L; [ "$lang" = az ] && lang=tr
  if has tldr; then tldr -L "$lang" "$c" 2>/dev/null || tldr "$c" 2>/dev/null && return; fi
  if has "$c"; then "$c" --help 2>&1 | head -40; else say "Unknown command. install? → install $c" "Naməlum əmr. Qurmaq: pkg install $c" "Bilinmeyen komut: pkg install $c" "Неизвестная команда: pkg install $c"; fi
}
cmd_fix() { # suggest a fix for a missing / mistyped command
  c=${1:-}; [ -n "$c" ] || { echo "fix <command>"; return; }
  printf '\033[33m%s\033[0m\n' "$(say "Command not found: $c" "Əmr tapılmadı: $c" "Komut bulunamadı: $c" "Команда не найдена: $c")"
  if pack_desc "$c" >/dev/null 2>&1; then echo "  → install $c"; return 127; fi
  best=$(for d in $(echo "$PATH" | tr ':' ' '); do ls "$d" 2>/dev/null; done | sort -u | awk -v w="$c" '
    function dist(a,b,  i,j,la,lb,d,c1,x,y,z){la=length(a);lb=length(b);for(i=0;i<=la;i++)d[i,0]=i;for(j=0;j<=lb;j++)d[0,j]=j
      for(i=1;i<=la;i++)for(j=1;j<=lb;j++){c1=(substr(a,i,1)==substr(b,j,1))?0:1;x=d[i-1,j]+1;y=d[i,j-1]+1;z=d[i-1,j-1]+c1;d[i,j]=(x<y?(x<z?x:z):(y<z?y:z))}return d[la,lb]}
    length($0)>1 && (dd=dist(w,$0))<=2 {print dd, $0}' | sort -n | head -3 | awk '{print $2}')
  [ -n "$best" ] && for b in $best; do printf '  → %s\n' "$b"; done
  printf '  → pkg install %s\n' "$c"
  return 127
}

