#!/bin/sh
# Nibras toolkit: short commands for everyday jobs. Tools are downloaded on first use
# (the app itself stays small). Run "nibras" for the menu, "install <pack>" to add a pack.
. /usr/local/share/nibras/msg.sh
L=$NIBRAS_LANG
me=${0##*/}; me=${me#nibras-}
if [ "$me" = kit ]; then me=${1:-menu}; [ $# -gt 0 ] && shift; fi
if lang_code_early=$(printf '%s' "$me" | tr 'A-Z' 'a-z') && case "$lang_code_early" in yukle|yüklə|yükle|yukla|تحميل|загрузить|dil|dili) true ;; *) false ;; esac; then
  set -- "$me" "$@"; me=guess_or_install
fi

say() { # say "en" "az" "tr" "ru"; other languages come from i18n/<lang>.tsv, English is the fallback
  case "$L" in
    az) printf '%s\n' "${2:-$1}" ;; tr) printf '%s\n' "${3:-$1}" ;; ru) printf '%s\n' "${4:-$1}" ;; en|"") printf '%s\n' "$1" ;;
    *) _s=$(nibras_i18n "$1"); printf '%s\n' "${_s:-$1}" ;;
  esac
}
die() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }
need() { nibras-need "$@" || die "$(say "Install failed: $*" "Quraşdırılmadı: $*" "Kurulamadı: $*" "Не установлено: $*")"; }
has() { command -v "$1" >/dev/null 2>&1; }
is_alpine() { has apk; }
outdir() {
  if [ -d /sdcard/Download ] && [ -w /sdcard/Download ]; then d=/sdcard/Download/Nibras; else d=$HOME/Nibras; fi
  mkdir -p "$d"; printf '%s' "$d"
}
ask_in() { printf '\033[1;36m%s\033[0m ' "$1" >&2; read -r REPLY; printf '%s' "$REPLY"; }
run() { printf '\033[2m$ %s\033[0m\n' "$*" >&2; "$@"; }
ip_addr() { ip -4 addr 2>/dev/null | awk '/inet /&&$2!~/^127/{sub(/\/.*/,"",$2);print $2;exit}'; }

