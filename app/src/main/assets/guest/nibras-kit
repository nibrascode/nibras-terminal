# ---------------------------------------------------------------- languages (human)
# lang [code|name|list|auto] — English is the default; every built-in language switches instantly.
LANGS="en az ar tr ru fa ur id ms fr de es pt it zh ja ko hi bn"
lang_code() { # word in any language/script → code (empty if not a language)
  w=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's/^lang-//')
  case "$w" in
    en|eng|english|ingilis|ingiliscə|ingilisce|ingilizce|i̇ngilizce|английский|الإنجليزية|الانجليزية|انجليزي|إنجليزي|انگلیسی|英语|英語|영어) echo en ;;
    az|aze|azerbaijani|azərbaycan|azerbaycan|azərbaycanca|azerbaycanca|azeri|azəri|azerice|azerbaycanca|азербайджанский|الأذربيجانية|آذربایجانی) echo az ;;
    ar|ara|arabic|ərəb|ereb|ərəbcə|erebce|arapça|arapca|арабский|العربية|عربي|عربية|عربى|عربی) echo ar ;;
    tr|tur|turkish|türk|turk|türkçe|turkce|türkcə|turkce|турецкий|التركية|تركي|ترکی) echo tr ;;
    ru|rus|russian|rusca|rusça|rusça|русский|русском|الروسية|روسي|روسی) echo ru ;;
    fa|per|persian|farsi|fars|farsca|farsça|فارسی|الفارسية|персидский) echo fa ;;
    ur|urdu|اردو|الأردية|урду) echo ur ;;
    id|indonesian|indonesia|indonez|endonezce|индонезийский|الإندونيسية) echo id ;;
    ms|malay|melayu|malayca|малайский|الماليزية) echo ms ;;
    fr|french|français|francais|fransız|fransiz|fransızca|французский|الفرنسية) echo fr ;;
    de|german|deutsch|alman|almanca|немецкий|الألمانية) echo de ;;
    es|spanish|español|espanol|ispan|ispanca|i̇spanyolca|ispanyolca|испанский|الإسبانية) echo es ;;
    pt|portuguese|português|portugues|portuqal|portekizce|португальский|البرتغالية) echo pt ;;
    it|italian|italiano|italyan|italyanca|итальянский|الإيطالية) echo it ;;
    zh|chinese|中文|汉语|漢語|çin|cin|çince|китайский|الصينية) echo zh ;;
    ja|japanese|日本語|yapon|japonca|японский|اليابانية) echo ja ;;
    ko|korean|한국어|koreya|korece|корейский|الكورية) echo ko ;;
    hi|hindi|हिन्दी|हिंदी|hind|hintçe|хинди|الهندية) echo hi ;;
    bn|bengali|bangla|বাংলা|benqal|bengalce|бенгальский|البنغالية) echo bn ;;
    *) return 1 ;;
  esac
}
lang_word() { # load / switch / language words (az tr en ru ar …)
  w=$(printf '%s' "$1" | tr 'A-Z' 'a-z')
  case "$w" in
    lang|language|dil|dili|dilini|yukle|yüklə|yükle|yukla|yüklə|install|load|set|switch|use|kur|qur|qurash|язык|загрузить|установить|تحميل|اللغة|لغة|زبان|langue|sprache|idioma|lingua|bahasa|语言|言語|언어|भाषा|ভাষা) return 0 ;;
  esac
  return 1
}
cmd_lang() {
  code=
  for w in "$@"; do c=$(lang_code "$w") && { code=$c; break; }; done
  case "${1:-}" in
    ""|list|ls|-l) [ -z "$code" ] && { nibras-api lang list 2>/dev/null || echo "$LANGS"; return 0; } ;;
    auto|system|device) code=auto ;;
  esac
  if [ -z "$code" ]; then nibras-api lang list 2>/dev/null || echo "$LANGS"; return 1; fi
  out=$(nibras-api lang "$code" 2>/dev/null) || out=
  if [ -z "$out" ]; then [ "$code" = auto ] && code=en; echo "$code" > /etc/nibras/lang 2>/dev/null; fi
  NIBRAS_LANG=$(cat /etc/nibras/lang 2>/dev/null || echo en); L=$NIBRAS_LANG
  nmsg lang_now "$NIBRAS_LANG"
}
cmd_guess() { # natural phrases like "az dili yukle", "türkçe yükle", "تحميل العربية", "lang ru"
  code=; hint=
  for w in "$@"; do lang_code "$w" >/dev/null && code=1; lang_word "$w" && hint=1; done
  if [ -n "$code" ] && { [ -n "$hint" ] || lang_code "${1:-}" >/dev/null; }; then cmd_lang "$@"; return 0; fi
  return 1
}

# ---------------------------------------------------------------- right-to-left text in the terminal
# rtl [file] — show Arabic/Persian/Urdu/Hebrew text shaped and in visual order (fribidi).
cmd_rtl() {
  has fribidi || need fribidi
  if [ $# -gt 0 ] && [ -f "$1" ]; then fribidi --nopad --width "$(tput cols 2>/dev/null || echo 80)" "$1"
  elif [ $# -gt 0 ]; then printf '%s\n' "$*" | fribidi --nopad
  else fribidi --nopad --width "$(tput cols 2>/dev/null || echo 80)"; fi
}

# ---------------------------------------------------------------- run any source file
# run <file|dir> [args] — detects the language, installs the runtime on first use, runs it.
need_cmd() { has "$1" || nibras-need "$1" >/dev/null 2>&1 || install_pack "$2" || die "$(say "Install failed: $2" "Quraşdırılmadı: $2" "Kurulamadı: $2" "Не установлено: $2")"; }
cmd_run() {
  f=${1:-}
  if [ -z "$f" ]; then
    say "run <file> [args] — python, js/ts, java, kotlin, c/c++, go, rust, php, ruby, perl, lua, dart, r, julia, haskell, elixir, zig, nim, bash, powershell…" \
        "run <fayl> [arqumentlər] — istənilən dildə faylı tanıyıb işə salır" "run <dosya> [argümanlar] — her dildeki dosyayı tanıyıp çalıştırır" "run <файл> [аргументы] — запускает файл на любом языке"
    return 1
  fi
  shift
  if [ -d "$f" ]; then
    cd "$f" || return 1
    if [ -f Cargo.toml ]; then need_cmd cargo dev; cargo run -- "$@"
    elif [ -f go.mod ]; then need_cmd go dev; go run . "$@"
    elif [ -f package.json ]; then need_cmd npm node; npm start -- "$@"
    elif [ -f settings.gradle ] || [ -f settings.gradle.kts ]; then nibras-apk run .
    elif [ -f pubspec.yaml ]; then need_cmd dart dart; dart run "$@"
    elif [ -f mix.exs ]; then need_cmd mix elixir; mix run
    elif [ -f build.zig ]; then need_cmd zig zig; zig build run
    elif [ -f CMakeLists.txt ]; then need_cmd cmake dev; cmake -B build -S . >/dev/null && cmake --build build -j2 && for x in build/*; do [ -f "$x" ] && [ -x "$x" ] && exec "$x" "$@"; done
    elif [ -f Makefile ] || [ -f makefile ]; then need_cmd make dev; make
    elif [ -f main.py ]; then need_cmd python3 python; python3 main.py "$@"
    else die "$(say "No project file found (Cargo.toml, go.mod, package.json, Makefile…)" "Layihə faylı tapılmadı (Cargo.toml, go.mod, package.json, Makefile…)" "Proje dosyası bulunamadı" "Файл проекта не найден")"; fi
    return
  fi
  [ -f "$f" ] || die "$f?"
  out=${TMPDIR:-/tmp}/nibras-run-$$; ext=${f##*.}; [ "$ext" = "$f" ] && ext=
  if [ -z "$ext" ]; then case "$(head -1 "$f")" in "#!"*) chmod +x "$f"; exec "./${f#./}" "$@" ;; esac; fi
  case "$(printf %s "$ext" | tr A-Z a-z)" in
    py|pyw) need_cmd python3 python; python3 "$f" "$@" ;;
    js|mjs|cjs) need_cmd node node; node "$f" "$@" ;;
    ts|mts|tsx) need_cmd node node; has tsx || npm install -g tsx >/dev/null 2>&1; tsx "$f" "$@" ;;
    java) has java || nibras-apk jdk; java "$f" "$@" ;;
    kt) has kotlinc || install_pack java; kotlinc -nowarn "$f" -include-runtime -d "$out.jar" && java -jar "$out.jar" "$@"; rm -f "$out.jar" ;;
    kts) has kotlinc || install_pack java; kotlinc -script "$f" "$@" ;;
    c) need_cmd cc dev; cc -O2 -o "$out" "$f" -lm && "$out" "$@"; rm -f "$out" ;;
    cc|cpp|cxx|c++) need_cmd c++ dev; c++ -O2 -std=c++20 -o "$out" "$f" && "$out" "$@"; rm -f "$out" ;;
    go) need_cmd go dev; go run "$f" "$@" ;;
    rs) need_cmd rustc dev; rustc -O -o "$out" "$f" && "$out" "$@"; rm -f "$out" ;;
    php) need_cmd php php; php "$f" "$@" ;;
    rb) need_cmd ruby ruby; ruby "$f" "$@" ;;
    pl) need_cmd perl perl; perl "$f" "$@" ;;
    lua) has lua || has lua5.4 || install_pack lua; if has lua; then lua "$f" "$@"; else lua5.4 "$f" "$@"; fi ;;
    dart) need_cmd dart dart; dart run "$f" "$@" ;;
    r) need_cmd Rscript r; Rscript "$f" "$@" ;;
    jl) need_cmd julia julia; julia "$f" "$@" ;;
    hs) need_cmd runghc haskell; runghc "$f" "$@" ;;
    ex|exs) need_cmd elixir elixir; elixir "$f" "$@" ;;
    zig) need_cmd zig zig; zig run "$f" -- "$@" ;;
    nim) need_cmd nim nim; nim r --hints:off "$f" "$@" ;;
    sh) sh "$f" "$@" ;; bash) need_cmd bash bash; bash "$f" "$@" ;; zsh) need_cmd zsh zsh; zsh "$f" "$@" ;; fish) need_cmd fish fish; fish "$f" "$@" ;;
    ps1) need_cmd pwsh powershell; pwsh -File "$f" "$@" ;;
    swift) need_cmd swift swift; swift "$f" "$@" ;;
    scala|sc) need_cmd scala-cli scala; scala-cli run "$f" -- "$@" ;;
    cs) need_cmd dotnet dotnet; dotnet run "$f" ;;
    f90|f95|f) need_cmd gfortran dev; gfortran -O2 -o "$out" "$f" && "$out" "$@"; rm -f "$out" ;;
    tcl) need_cmd tclsh tcl; tclsh "$f" "$@" ;;
    awk) awk -f "$f" "$@" ;;
    sql) need_cmd sqlite3 sqlite3; sqlite3 :memory: < "$f" ;;
    html|htm|svg) nibras-api open "$f" ;;
    md|markdown) has glow && glow "$f" || cat "$f" ;;
    *) die "$(say "Unknown file type: .$ext" "Naməlum fayl növü: .$ext" "Bilinmeyen dosya türü: .$ext" "Неизвестный тип файла: .$ext")" ;;
  esac
}

