TRASH=$HOME/.local/share/Trash
cmd_trash() {
  mkdir -p "$TRASH/files" "$TRASH/info"
  case "${1:-}" in
    ""|help) echo "trash <files…> · trash list · trash restore <name> · trash empty"; return ;;
    list) ls -la "$TRASH/files"; return ;;
    empty) rm -rf "$TRASH/files"/* "$TRASH/info"/*; say "Trash emptied" "Zibil qutusu boşaldıldı" "Çöp boşaltıldı" "Корзина очищена"; return ;;
    restore) n=$2; src=$(sed -n 's/^Path=//p' "$TRASH/info/$n.trashinfo" 2>/dev/null); [ -n "$src" ] || die "?"; mv "$TRASH/files/$n" "$src" && rm -f "$TRASH/info/$n.trashinfo" && echo "→ $src"; return ;;
  esac
  for f in "$@"; do
    [ -e "$f" ] || [ -L "$f" ] || { echo "? $f" >&2; continue; }
    n=$(basename "$f"); [ -e "$TRASH/files/$n" ] && n="$n.$(date +%s)"
    printf '[Trash Info]\nPath=%s\nDeletionDate=%s\n' "$(readlink -f "$f")" "$(date +%FT%T)" > "$TRASH/info/$n.trashinfo"
    mv "$f" "$TRASH/files/$n"
  done
}
cmd_clip() {
  h=$HOME/.local/share/nibras-clip; touch "$h"
  case "${1:-list}" in
    list) nl -ba "$h" | tail -30 ;;
    save) c=$(nibras-clipboard-get); [ -n "$c" ] && printf '%s\n' "$c" | tr '\n' ' ' | sed 's/ $//' >> "$h" && echo >> "$h" ;;
    [0-9]*) sed -n "${1}p" "$h" | nibras-clipboard-set; say "Copied" "Kopyalandı" "Kopyalandı" "Скопировано" ;;
    clear) : > "$h" ;;
    *) echo "clip [list|save|N|clear]" ;;
  esac
}
cmd_notes() {
  d=$HOME/notes; mkdir -p "$d"
  case "${1:-list}" in
    list) ls -t "$d" | head -40 ;;
    new) f=$d/${2:-$(date +%F-%H%M)}.md; [ -f "$f" ] || printf '# %s\n\n' "${2:-$(date '+%F %H:%M')}" > "$f"; nibras-api edit "$f" 2>/dev/null || ${EDITOR:-vi} "$f" ;;
    show) f=$d/${2%.md}.md; if has glow; then glow "$f"; else sed -e 's/^# \(.*\)/\x1b[1;33m\1\x1b[0m/' -e 's/^## \(.*\)/\x1b[1;36m\1\x1b[0m/' -e 's/\*\*\([^*]*\)\*\*/\x1b[1m\1\x1b[0m/g' "$f"; fi ;;
    find) grep -rin --color=auto "$2" "$d" ;;
    add) shift; printf -- '- %s  (%s)\n' "$*" "$(date '+%F %H:%M')" >> "$d/inbox.md"; echo "✓ inbox.md" ;;
    *) echo "notes [list|new [name]|show name|find text|add text]" ;;
  esac
}
cmd_vault() {
  need age tar; v=$(outdir)/vault; mkdir -p "$v"
  case "${1:-help}" in
    lock) d=${2:?folder}; out=$v/$(basename "$d").tar.age; tar -C "$(dirname "$(readlink -f "$d")")" -cz "$(basename "$d")" | age -p -o "$out" && \
      { c=$(ask_in "$(say "Delete the original folder? (yes)" "Orijinal qovluq silinsin? (yes)" "Orijinal klasör silinsin mi? (yes)" "Удалить оригинал? (yes)")"); [ "$c" = yes ] && rm -rf "$d"; echo "→ $out"; } ;;
    open) f=${2:?file}; [ -f "$f" ] || f=$v/$f; age -d "$f" | tar -xz -C "${3:-.}" && echo "✓" ;;
    list) ls -lh "$v" ;;
    *) echo "vault lock <folder> · vault open <file.tar.age> [to] · vault list   (age, password)" ;;
  esac
}
cmd_record() {
  d=$(outdir)/recordings; mkdir -p "$d"
  case "${1:-start}" in
    start) f=$d/session-$(date +%F-%H%M%S)
      say "Recording… type exit to stop" "Yazılır… dayandırmaq üçün exit yaz" "Kaydediliyor… durdurmak için exit" "Запись… exit для остановки"
      if has asciinema; then asciinema rec "$f.cast"; else need script; script -q -t 2>"$f.time" "$f.log"; fi; echo "→ $f" ;;
    play) f=$2; case "$f" in *.cast) asciinema play "$f" ;; *) scriptreplay "${f%.log}.time" "${f%.log}.log" ;; esac ;;
    gif|video|mp4)
      f=${2:-$(ls -t "$d"/*.cast 2>/dev/null | head -1)}; [ -f "$f" ] || die "record gif <file.cast>  ($(say "record with asciinema first" "əvvəlcə asciinema ilə yaz" "önce asciinema ile kaydet" "сначала запишите через asciinema"))"
      install_agg; g=${f%.cast}.gif
      agg --font-size 20 --theme monokai "$f" "$g" || die agg
      if [ "$1" = gif ]; then echo "→ $g"; else need ffmpeg; ffmpeg -hide_banner -y -i "$g" -movflags faststart -pix_fmt yuv420p -vf "scale=trunc(iw/2)*2:trunc(ih/2)*2" "${f%.cast}.mp4" && echo "→ ${f%.cast}.mp4"; fi
      nibras-media-scan "$d" >/dev/null 2>&1 ;;
    list) ls -lh "$d" ;;
    *) echo "record [start|play file|list|gif [file.cast]|video [file.cast]]" ;;
  esac
}
install_agg() {
  has agg && return 0
  nibras-need agg >/dev/null 2>&1 && return 0
  case "$(uname -m)" in aarch64|arm64) t=aarch64-unknown-linux-gnu ;; armv7l|armv8l|arm*) t=arm-unknown-linux-gnueabihf ;; x86_64) t=x86_64-unknown-linux-musl ;; *) die "agg: $(uname -m)" ;; esac
  is_alpine && apk add gcompat libgcc >/dev/null 2>&1
  curl -fL -o /usr/local/bin/agg "https://github.com/asciinema/agg/releases/latest/download/agg-$t" && chmod +x /usr/local/bin/agg || die "agg download"
}
cron_start() { pgrep crond >/dev/null 2>&1 || { has crond && crond 2>/dev/null; } || { has cron && cron 2>/dev/null; } || true; }
cmd_cron() {
  has crontab || need crontab
  case "${1:-list}" in
    list) crontab -l 2>/dev/null | nl -ba; [ -t 1 ] && say "(cron menu = buttons)" "(cron menu = düymələrlə)" "(cron menu = düğmelerle)" "(cron menu = кнопками)" ;;
    add) shift; when=$1; shift
      case "$when" in hourly) when="0 * * * *" ;; daily) when="0 9 * * *" ;; every5) when="*/5 * * * *" ;; weekly) when="0 9 * * 1" ;; esac
      (crontab -l 2>/dev/null; echo "$when $*") | crontab -; cron_start; echo "✓ $when $*" ;;
    rm|remove) crontab -l 2>/dev/null | sed "${2}d" | crontab - ;;
    menu|ui)
      w=$(nibras-dialog radio -t "cron" -v "$(say "Every 5 minutes,Every hour,Every day 09:00,Every Monday 09:00,Custom" "Hər 5 dəqiqə,Hər saat,Hər gün 09:00,Hər bazar ertəsi 09:00,Öz vaxtım" "Her 5 dakika,Her saat,Her gün 09:00,Her pazartesi 09:00,Özel" "Каждые 5 минут,Каждый час,Каждый день 09:00,Каждый понедельник 09:00,Своё")" 2>/dev/null | sed -n 's/.*"index": *\([0-9]*\).*/\1/p')
      case "$w" in 0) when="*/5 * * * *" ;; 1) when="0 * * * *" ;; 2) when="0 9 * * *" ;; 3) when="0 9 * * 1" ;;
        4) when=$(nibras-dialog text -t "m h d M w" -i "30 7 * * *" 2>/dev/null | sed -n 's/.*"text": *"\([^"]*\)".*/\1/p') ;; *) return 0 ;; esac
      c=$(nibras-dialog text -t "$(say "Command" "Əmr" "Komut" "Команда")" -i "backup ~/projects" 2>/dev/null | sed -n 's/.*"text": *"\([^"]*\)".*/\1/p')
      [ -n "$when" ] && [ -n "$c" ] && cmd_cron add "$when" "$c"; cmd_cron list ;;
    *) echo "cron list · cron add hourly|daily|weekly|every5|\"m h d M w\" <command> · cron rm N   ($(say "for jobs even when the app is closed:" "tətbiq bağlı olanda da işləmək üçün:" "uygulama kapalıyken de:" "даже при закрытом приложении:") nibras-job-scheduler)" ;;
  esac
}
cmd_plugin() {
  d=$HOME/.nibras/plugins; mkdir -p "$d"
  case "${1:-list}" in
    list) ls "$d" ;;
    install) need curl; n=${3:-$(basename "$2")}; curl -fsSL "$2" -o "$d/$n" && chmod +x "$d/$n"
      head -5 "$d/$n"; say "Installed. Plugins are your own scripts — install only from people you trust." "Quraşdırıldı. Yalnız güvəndiyin mənbədən quraşdır." "Kuruldu. Sadece güvendiğin kaynaktan kur." "Установлено. Только из доверенных источников." ;;
    new) n=${2:?name}; printf '#!/bin/sh\n# %s: Nibras plugin. Runs as the command "%s".\necho "hello from %s"\n' "$n" "$n" "$n" > "$d/$n"; chmod +x "$d/$n"; nibras-api edit "$d/$n" ;;
    remove|rm) rm -f "$d/$2" ;;
    *) echo "plugin list · plugin new <name> · plugin install <url> [name] · plugin rm <name>  (~/.nibras/plugins is on PATH)" ;;
  esac
}
cmd_hs() { # history search
  h=$HISTFILE; [ -f "$h" ] || h=$HOME/.ash_history
  if has fzf; then c=$(tac "$h" 2>/dev/null | awk '!s[$0]++' | fzf --height 40% --reverse) && printf '%s\n' "$c" && nibras-clipboard-set "$c" 2>/dev/null
  elif [ -n "${1:-}" ]; then grep -i -- "$1" "$h" | awk '!s[$0]++' | tail -30
  else tail -30 "$h"; say "(install fzf for interactive search: pkg install fzf)" "(interaktiv axtarış üçün: pkg install fzf)" "(etkileşimli arama: pkg install fzf)" "(pkg install fzf)"; fi
}
cmd_sysinfo() {
  . /etc/os-release 2>/dev/null
  printf '\033[1;32m%s\033[0m %s · %s\n' "${PRETTY_NAME:-Linux}" "$(uname -m)" "$(uname -r)"
  awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "RAM  %d / %d MB\n",(t-a)/1024,t/1024}' /proc/meminfo
  df -h / 2>/dev/null | awk 'NR==2{print "Disk " $3 " / " $2}'
  echo "CPU  $(nproc) × $(awk -F: '/Hardware|model name/{print $2;exit}' /proc/cpuinfo)"
  nibras-battery-status 2>/dev/null | tr -d '{}",' | grep -E "percentage|status" | sed 's/^ */Batt /'
}

