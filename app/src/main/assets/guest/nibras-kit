PACKS="arch fedora kali debian ubuntu lsp video audio image pdf download web git python node dev apk backup net ocr share webterm desktop llm quran prayer games learn record vault notes monitor security office"

install_pack() {
  p=$1
  case "$p" in
    arch|fedora|kali|debian|ubuntu)
      case "$p:$(uname -m)" in
        fedora:armv7l|fedora:armv8l|fedora:arm) die "$(say "Fedora has no 32-bit ARM build since Fedora 37; use Debian, Arch or Kali." "Fedora-nın 37-dən sonra 32-bit ARM versiyası yoxdur; Debian, Arch ya da Kali seç." "Fedora 37'den beri 32-bit ARM sürümü yok; Debian, Arch veya Kali seç." "У Fedora нет 32-битной ARM-сборки с версии 37; выберите Debian, Arch или Kali.")" ;;
      esac
      nibras-api env-install "$p"; return ;;
    lsp) lsp_install ;;
    video) need ffmpeg ;;
    audio) need ffmpeg sox ;;
    image) need magick 2>/dev/null || need convert ;;
    pdf) need qpdf gs pdfinfo ;;
    download) need python3 ffmpeg aria2c curl; install_ytdlp ;;
    web) need python3 ;;
    git) need git ssh ;;
    python|py) need python3 pip3; is_alpine && apk add py3-virtualenv >/dev/null 2>&1; true ;;
    node) need node ;;
    dev) need gcc g++ make; nibras-need cmake go rustc >/dev/null || true ;;
    apk) nibras-apk setup ;;
    backup) need tar rsync rclone zip unzip ;;
    net) need nmap ping curl dig traceroute; nibras-need speedtest-cli whois >/dev/null || true ;;
    ocr) need tesseract
      if is_alpine; then for l in aze tur rus ara; do apk add "tesseract-ocr-data-$l" >/dev/null 2>&1; done
      else apt-get install -y tesseract-ocr-aze tesseract-ocr-tur tesseract-ocr-rus tesseract-ocr-ara >/dev/null 2>&1; fi; true ;;
    share) need rclone qrencode ;;
    webterm) need ttyd qrencode ;;
    desktop) nibras-desktop install ;;
    llm) llm_setup ;;
    quran|prayer) need curl jq ;;
    games) games_install ;;
    learn) true ;;
    record) nibras-need asciinema >/dev/null 2>&1 || need script ;;
    vault) need age tar ;;
    notes) nibras-need glow >/dev/null 2>&1 || true ;;
    monitor) need htop; nibras-need btop >/dev/null 2>&1 || true ;;
    security) need nmap; for t in hydra sqlmap nikto john hashcat aircrack-ng; do nibras-need "$t" >/dev/null 2>&1; done; true ;;
    office) need pandoc ;;
    *) die "$(say "Unknown pack: $p" "Naməlum paket: $p" "Bilinmeyen paket: $p" "Неизвестный пакет: $p")" ;;
  esac && printf '\033[32m✓ %s\033[0m\n' "$(say "Ready: $p" "Hazırdır: $p" "Hazır: $p" "Готово: $p")"
}

lsp_install() {
  # Language servers for terminal editors with real LSP (helix / neovim): Python, Bash, C/C++, JS/TS, JSON/HTML/CSS, YAML, Go, Rust.
  nibras-need hx >/dev/null 2>&1 || nibras-need helix >/dev/null 2>&1 || need nvim
  need python3 pip3 node npm
  pip3 install -q python-lsp-server pyflakes --break-system-packages 2>/dev/null || pip3 install -q python-lsp-server pyflakes
  npm install -g --silent bash-language-server typescript typescript-language-server vscode-langservers-extracted yaml-language-server >/dev/null 2>&1 || true
  nibras-need clangd >/dev/null 2>&1 || nibras-need clang >/dev/null 2>&1 || true
  nibras-need shellcheck >/dev/null 2>&1 || true
  has go && go install golang.org/x/tools/gopls@latest >/dev/null 2>&1 || true
  has rustup && rustup component add rust-analyzer >/dev/null 2>&1 || true
  say "LSP ready: open files with  hx <file>  (helix, LSP built in) or nvim; the Nibras editor has 🩺 Check code." \
      "LSP hazırdır: faylı  hx <fayl>  (helix, LSP daxili) ya da nvim ilə aç; Nibras redaktorunda 🩺 Kodu yoxla var." \
      "LSP hazır: dosyayı  hx <dosya>  (helix) veya nvim ile aç; Nibras editöründe 🩺 Kodu denetle var." \
      "LSP готов: открывайте  hx <файл>  (helix) или nvim; в редакторе Nibras есть 🩺 Проверить код."
}

install_ytdlp() {
  has yt-dlp && return 0
  say "Downloading yt-dlp…" "yt-dlp yüklənir…" "yt-dlp indiriliyor…" "Загрузка yt-dlp…"
  curl -fL -o /usr/local/bin/yt-dlp https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp && chmod +x /usr/local/bin/yt-dlp \
    || pip3 install -U yt-dlp --break-system-packages || die "yt-dlp"
}

cmd_install() {
  if [ $# -eq 0 ]; then
    say "Packs (install <name>):" "Paketlər (install <ad>):" "Paketler (install <ad>):" "Пакеты (install <имя>):"
    for p in $PACKS; do printf '  \033[1;32m%-9s\033[0m %s\n' "$p" "$(pack_desc "$p")"; done
    say "Any other Linux package: pkg install <name>" "Başqa istənilən Linux paketi: pkg install <ad>" "Başka herhangi bir paket: pkg install <ad>" "Любой другой пакет: pkg install <имя>"
    return
  fi
  for p in "$@"; do
    if pack_desc "$p" >/dev/null; then install_pack "$p"; else pkg install "$p"; fi
  done
}

# ---------------------------------------------------------------- menu
cmd_menu() {
  printf '\033[1;32m  Nibras Terminal\033[0m — %s\n\n' "$(say "tools" "alətlər" "araçlar" "инструменты")"
  i=1
  for p in $PACKS; do printf '  \033[1;33m%2d\033[0m \033[1m%-9s\033[0m %s\n' $i "$p" "$(pack_desc "$p")"; i=$((i+1)); done
  cat <<EOF

  ask · explain · fix · recipes · trash · qr · clip · snapshot · cron · plugin · hs · sysinfo
  hosts · files · edit · desktop · adb · rish · sshd · apk · install
EOF
  [ -t 0 ] || return 0
  n=$(ask_in "$(say "Number or name (Enter = exit):" "Nömrə və ya ad (Enter = çıxış):" "Numara veya ad (Enter = çıkış):" "Номер или имя (Enter = выход):")")
  [ -z "$n" ] && return 0
  case "$n" in *[!0-9]*) p=$n ;; *) p=$(echo $PACKS | tr ' ' '\n' | sed -n "${n}p") ;; esac
  [ -n "$p" ] || return 0
  case "$p" in web|share|backup|snapshot|webterm|vault|notes|cron|record|ocr|llm|quran|prayer|net|audio|image|pdf|git) nibras-kit "$p" help ;;
    apk) nibras-apk ;; dev|desktop|security|monitor|office|python|node) cmd_install "$p" ;; *) nibras-kit "$p" ;; esac
}

cmd_list() { for p in $PACKS; do printf '%-9s %s\n' "$p" "$(pack_desc "$p")"; done; }

# ---------------------------------------------------------------- video
cmd_video() {
  a=${1:-}; [ $# -gt 0 ] && shift
  case "$a" in
    ""|menu) video_menu; return ;;
    gui|ui) exec nibras-api media-builder video ;;
    help|-h) cat <<EOF
video merge a.mp4 b.mp4 … [out.mp4]   $(say "join videos" "videoları birləşdir" "videoları birleştir" "склеить")
video cut in.mp4 00:01:00 00:02:30     $(say "cut a part (start end)" "hissə kəs (başlanğıc son)" "parça kes" "вырезать")
video convert in.mkv out.mp4           $(say "change format" "format dəyiş" "format değiştir" "сменить формат")
video compress in.mp4 [crf 28]         $(say "make smaller" "kiçilt" "küçült" "сжать")
video audio in.mp4 [mp3]               $(say "extract audio" "səsi çıxar" "sesi çıkar" "извлечь звук")
video gif in.mp4 [start] [seconds]     GIF
video resize in.mp4 720                $(say "scale to height" "hündürlüyə görə ölçü" "yüksekliğe göre boyut" "высота")
video rotate in.mp4 [90|180|270]
video mute in.mp4 · video speed in.mp4 2 · video frames in.mp4 · video info in.mp4
video subs in.mp4 subs.srt             $(say "burn subtitles" "altyazı əlavə et" "altyazı göm" "вшить субтитры")
EOF
      return ;;
  esac
  need ffmpeg
  o=$(outdir)
  case "$a" in
    merge|join)
      [ $# -ge 2 ] || die "video merge a.mp4 b.mp4 [out.mp4]"
      last=$(eval echo "\${$#}"); out=; case "$last" in *.mp4|*.mkv|*.mov|*.webm) [ -e "$last" ] || out=$last ;; esac
      list=$(mktemp); n=0
      for f in "$@"; do [ "$f" = "$out" ] && continue; printf "file '%s'\n" "$(readlink -f "$f")" >> "$list"; n=$((n+1)); done
      out=${out:-$o/merged-$(date +%H%M%S).mp4}
      run ffmpeg -hide_banner -f concat -safe 0 -i "$list" -c copy "$out" || {
        say "Different formats — re-encoding…" "Formatlar fərqlidir — yenidən kodlanır…" "Formatlar farklı — yeniden kodlanıyor…" "Разные форматы — перекодирование…"
        run ffmpeg -hide_banner -y -f concat -safe 0 -i "$list" -c:v libx264 -preset veryfast -crf 23 -c:a aac "$out"; }
      rm -f "$list"; echo "→ $out" ;;
    cut|trim) [ $# -ge 3 ] || die "video cut in.mp4 START END"; out=$o/cut-$(basename "$1"); run ffmpeg -hide_banner -y -ss "$2" -to "$3" -i "$1" -c copy "$out"; echo "→ $out" ;;
    convert) [ $# -ge 2 ] || die "video convert in out.ext"; run ffmpeg -hide_banner -y -i "$1" "$2" ;;
    compress) out=$o/small-$(basename "${1%.*}").mp4; run ffmpeg -hide_banner -y -i "$1" -c:v libx264 -preset veryfast -crf "${2:-28}" -c:a aac -b:a 96k "$out"
      echo "→ $out ($(du -h "$1" | cut -f1) → $(du -h "$out" | cut -f1))" ;;
    audio|mp3) ext=${2:-mp3}; out=$o/$(basename "${1%.*}").$ext; run ffmpeg -hide_banner -y -i "$1" -vn "$out"; echo "→ $out" ;;
    gif) out=$o/$(basename "${1%.*}").gif; run ffmpeg -hide_banner -y -ss "${2:-0}" -t "${3:-5}" -i "$1" -vf "fps=12,scale=480:-1:flags=lanczos,split[a][b];[a]palettegen[p];[b][p]paletteuse" "$out"; echo "→ $out" ;;
    resize) out=$o/${2:-720}p-$(basename "$1"); run ffmpeg -hide_banner -y -i "$1" -vf "scale=-2:${2:-720}" -c:a copy "$out"; echo "→ $out" ;;
    rotate) case "${2:-90}" in 90) vf=transpose=1 ;; 180) vf="transpose=1,transpose=1" ;; 270) vf=transpose=2 ;; *) die "90|180|270" ;; esac
      out=$o/rot-$(basename "$1"); run ffmpeg -hide_banner -y -i "$1" -vf "$vf" -c:a copy "$out"; echo "→ $out" ;;
    mute) out=$o/mute-$(basename "$1"); run ffmpeg -hide_banner -y -i "$1" -an -c:v copy "$out"; echo "→ $out" ;;
    speed) s=${2:-2}; out=$o/x$s-$(basename "$1"); run ffmpeg -hide_banner -y -i "$1" -filter_complex "[0:v]setpts=PTS/$s[v];[0:a]atempo=$s[a]" -map "[v]" -map "[a]" "$out"; echo "→ $out" ;;
    frames) d=$o/frames-$(basename "${1%.*}"); mkdir -p "$d"; run ffmpeg -hide_banner -i "$1" -vf fps="${2:-1}" "$d/%04d.jpg"; echo "→ $d" ;;
    subs) out=$o/subs-$(basename "$1"); run ffmpeg -hide_banner -y -i "$1" -vf "subtitles=$2" -c:a copy "$out"; echo "→ $out" ;;
    info) need ffprobe; ffprobe -hide_banner "$1" ;;
    *) die "video help" ;;
  esac
}

video_menu() {
  say "What do you want to do?" "Nə etmək istəyirsən?" "Ne yapmak istiyorsun?" "Что сделать?"
  echo " 1) merge  2) cut  3) compress  4) audio  5) gif  6) convert  7) resize"
  c=$(ask_in ">")
  case "$c" in
    1) f=$(ask_in "$(say "Files (space separated, * works):" "Fayllar (boşluqla, * işləyir):" "Dosyalar (boşlukla, * çalışır):" "Файлы (через пробел):")"); eval "set -- $f"; cmd_video merge "$@" ;;
    2) f=$(ask_in "File:"); s=$(ask_in "Start (00:00:10):"); e=$(ask_in "End (00:01:00):"); cmd_video cut "$f" "$s" "$e" ;;
    3) f=$(ask_in "File:"); cmd_video compress "$f" ;;
    4) f=$(ask_in "File:"); cmd_video audio "$f" ;;
    5) f=$(ask_in "File:"); s=$(ask_in "Start sec:"); d=$(ask_in "Seconds:"); cmd_video gif "$f" "${s:-0}" "${d:-5}" ;;
    6) f=$(ask_in "File:"); t=$(ask_in "Output (out.mp4):"); cmd_video convert "$f" "$t" ;;
    7) f=$(ask_in "File:"); h=$(ask_in "Height (720):"); cmd_video resize "$f" "${h:-720}" ;;
  esac
}

# ---------------------------------------------------------------- audio
cmd_audio() {
  a=${1:-help}; [ $# -gt 0 ] && shift
  [ "$a" = help ] && { echo "audio convert in.wav out.mp3 · audio cut in.mp3 START END · audio merge a.mp3 b.mp3 · audio normalize in.mp3 · audio record [seconds] · audio info in.mp3"; return; }
  need ffmpeg; o=$(outdir)
  case "$a" in
    convert) run ffmpeg -hide_banner -y -i "$1" "$2" ;;
    cut) out=$o/cut-$(basename "$1"); run ffmpeg -hide_banner -y -ss "$2" -to "$3" -i "$1" -c copy "$out"; echo "→ $out" ;;
    merge) list=$(mktemp); for f in "$@"; do printf "file '%s'\n" "$(readlink -f "$f")" >> "$list"; done; out=$o/merged-$(date +%H%M%S).mp3
      run ffmpeg -hide_banner -y -f concat -safe 0 -i "$list" -c:a libmp3lame -q:a 2 "$out"; rm -f "$list"; echo "→ $out" ;;
    normalize) out=$o/norm-$(basename "$1"); run ffmpeg -hide_banner -y -i "$1" -af loudnorm "$out"; echo "→ $out" ;;
    record) out=$o/rec-$(date +%H%M%S).m4a; nibras-microphone-record -f "$out" -l "${1:-30}" ;;
    info) ffprobe -hide_banner "$1" ;;
    *) die "audio help" ;;
  esac
}

# ---------------------------------------------------------------- image
im() { if has magick; then magick "$@"; else convert "$@"; fi; }
cmd_image() {
  a=${1:-help}; [ $# -gt 0 ] && shift
  [ "$a" = help ] && { echo "image resize in.jpg 50%|1080 · image convert in.png out.webp · image compress in.jpg [quality] · image pdf *.jpg · image crop in.jpg WxH+X+Y · image rotate in.jpg 90 · image gray in.jpg · image info in.jpg · image batch 1080 *.jpg"; return; }
  has magick || has convert || need convert; o=$(outdir)
  case "$a" in
    resize) out=$o/$(basename "$1"); s=$2; case "$s" in *%) ;; *) s="${s}x${s}>" ;; esac; run im "$1" -resize "$s" "$out"; echo "→ $out" ;;
    convert) run im "$1" "$2" ;;
    compress) out=$o/small-$(basename "${1%.*}").jpg; run im "$1" -strip -quality "${2:-75}" "$out"; echo "→ $out" ;;
    pdf) out=$o/images-$(date +%H%M%S).pdf; run im "$@" "$out"; echo "→ $out" ;;
    crop) out=$o/crop-$(basename "$1"); run im "$1" -crop "$2" +repage "$out"; echo "→ $out" ;;
    rotate) out=$o/rot-$(basename "$1"); run im "$1" -rotate "${2:-90}" "$out"; echo "→ $out" ;;
    gray) out=$o/gray-$(basename "$1"); run im "$1" -colorspace Gray "$out"; echo "→ $out" ;;
    info) if has magick; then magick identify -verbose "$1" | head -30; else identify -verbose "$1" | head -30; fi ;;
    batch) s=$1; shift; for f in "$@"; do run im "$f" -resize "${s}x${s}>" "$o/$(basename "$f")"; done; echo "→ $o" ;;
    *) die "image help" ;;
  esac
}

# ---------------------------------------------------------------- pdf
cmd_pdf() {
  a=${1:-help}; [ $# -gt 0 ] && shift
  [ "$a" = help ] && { echo "pdf merge a.pdf b.pdf … · pdf split in.pdf [pages 1-3] · pdf compress in.pdf · pdf text in.pdf · pdf images in.pdf · pdf info in.pdf · pdf rotate in.pdf 90 · pdf lock in.pdf · pdf unlock in.pdf"; return; }
  o=$(outdir)
  case "$a" in
    merge) need qpdf; out=$o/merged-$(date +%H%M%S).pdf; run qpdf --empty --pages "$@" -- "$out"; echo "→ $out" ;;
    split) need qpdf; if [ -n "${2:-}" ]; then out=$o/pages-$2-$(basename "$1"); run qpdf "$1" --pages . "$2" -- "$out"; echo "→ $out"
      else d=$o/split-$(basename "${1%.*}"); mkdir -p "$d"; run qpdf --split-pages "$1" "$d/page-%d.pdf"; echo "→ $d"; fi ;;
    compress) need gs; out=$o/small-$(basename "$1"); run gs -q -sDEVICE=pdfwrite -dPDFSETTINGS=/ebook -dNOPAUSE -dBATCH -sOutputFile="$out" "$1"
      echo "→ $out ($(du -h "$1" | cut -f1) → $(du -h "$out" | cut -f1))" ;;
    text) need pdftotext; out=$o/$(basename "${1%.*}").txt; run pdftotext -layout "$1" "$out"; echo "→ $out" ;;
    images) need pdftoppm; d=$o/$(basename "${1%.*}"); mkdir -p "$d"; run pdftoppm -jpeg -r 150 "$1" "$d/page"; echo "→ $d" ;;
    info) need pdfinfo; pdfinfo "$1" ;;
    rotate) need qpdf; out=$o/rot-$(basename "$1"); run qpdf "$1" --rotate="+${2:-90}" -- "$out"; echo "→ $out" ;;
    lock) need qpdf; pw=$(ask_in "Password:"); out=$o/locked-$(basename "$1"); qpdf --encrypt "$pw" "$pw" 256 -- "$1" "$out"; echo "→ $out" ;;
    unlock) need qpdf; pw=$(ask_in "Password:"); out=$o/open-$(basename "$1"); qpdf --password="$pw" --decrypt "$1" "$out"; echo "→ $out" ;;
    *) die "pdf help" ;;
  esac
}

# ---------------------------------------------------------------- download
cmd_download() {
  a=${1:-}
  case "$a" in
    gui|ui) exec nibras-api media-builder download ;;
    ""|menu) u=$(ask_in "URL:"); [ -n "$u" ] || return 0
      echo " 1) $(say "best video" "ən yaxşı video" "en iyi video" "лучшее видео")  2) mp3  3) 720p  4) $(say "file" "fayl" "dosya" "файл")"
      c=$(ask_in ">"); case "$c" in 2) cmd_download audio "$u" ;; 3) cmd_download video "$u" 720 ;; 4) cmd_download file "$u" ;; *) cmd_download video "$u" ;; esac; return ;;
    help|-h) cat <<EOF
download <url>                 $(say "video/music from YouTube & 1000+ sites, or any file" "YouTube və 1000+ saytdan video/musiqi, ya da istənilən fayl" "YouTube ve 1000+ siteden video/müzik veya dosya" "видео/музыка или любой файл")
download audio <url>           mp3
download video <url> [720]     $(say "max height" "maks. hündürlük" "maks. yükseklik" "макс. высота")
download playlist <url>
download file <url>            $(say "fast, resumable (aria2)" "sürətli, davam etdirilən (aria2)" "hızlı, devam ettirilebilir" "быстро, с докачкой")
download update                $(say "update yt-dlp" "yt-dlp-ni yenilə" "yt-dlp güncelle" "обновить yt-dlp")
download --android <url>       $(say "via Android download manager" "Android yükləmə meneceri ilə" "Android indirme yöneticisi" "через Android")
$(say "Download only content you have the right to." "Yalnız hüququn olan məzmunu yüklə." "Sadece hakkın olan içeriği indir." "Скачивайте только разрешённый контент.")
EOF
      return ;;
    --android) shift; exec nibras-api download "$@" ;;
  esac
  o=$(outdir); [ $# -gt 0 ] && shift
  case "$a" in
    update) install_ytdlp; yt-dlp -U ;;
    audio) need python3 ffmpeg; install_ytdlp; run yt-dlp -x --audio-format mp3 --embed-thumbnail --add-metadata -o "$o/%(title)s.%(ext)s" "$@" ;;
    video) need python3 ffmpeg; install_ytdlp; h=${2:-}; f="bv*+ba/b"; [ -n "$h" ] && f="bv*[height<=$h]+ba/b[height<=$h]"
      run yt-dlp -f "$f" --merge-output-format mp4 -o "$o/%(title)s.%(ext)s" "$1" ;;
    playlist) need python3 ffmpeg; install_ytdlp; run yt-dlp -f "bv*+ba/b" --merge-output-format mp4 -o "$o/%(playlist_title)s/%(playlist_index)03d %(title)s.%(ext)s" "$@" ;;
    file) need aria2c; run aria2c -x 8 -s 8 -c -d "$o" "$@" ;;
    http://*|https://*)
      case "$a" in
        *.zip|*.apk|*.pdf|*.iso|*.gz|*.xz|*.tar|*.mp3|*.jpg|*.png|*.deb|*.exe|*.7z) need aria2c; run aria2c -x 8 -s 8 -c -d "$o" "$a" ;;
        *) need python3 ffmpeg; install_ytdlp; run yt-dlp -f "bv*+ba/b" --merge-output-format mp4 -o "$o/%(title)s.%(ext)s" "$a" || { need aria2c; aria2c -c -d "$o" "$a"; } ;;
      esac ;;
    *) die "download help" ;;
  esac
}

# ---------------------------------------------------------------- web / git / python / node / dev
cmd_web() {
  a=${1:-.}
  case "$a" in
    help|-h) echo "web [folder] [port]   ·  web php [folder]  ·  web node [folder]   ($(say "instant web server" "ani veb server" "anında web sunucu" "веб-сервер"))"; return ;;
    php) need php; d=${2:-.}; ip=$(ip_addr); echo "http://127.0.0.1:8080  http://$ip:8080"; exec php -S 0.0.0.0:8080 -t "$d" ;;
    node) need node; d=${2:-.}; ip=$(ip_addr); echo "http://127.0.0.1:8080  http://$ip:8080"; exec npx --yes http-server "$d" -p 8080 ;;
  esac
  need python3; port=${2:-8000}; ip=$(ip_addr)
  echo "http://127.0.0.1:$port  ·  http://$ip:$port"; has qrencode && qrencode -t ansiutf8 "http://$ip:$port"
  cd "$a" && exec python3 -m http.server "$port"
}
cmd_git() {
  need git; a=${1:-help}; [ $# -gt 0 ] && shift
  case "$a" in
    help) echo "git: get <url> · save \"message\" · sync · undo · log · setup"; ;;
    get) run git clone --depth 1 "$@" ;;
    save) git add -A && git commit -m "${1:-update $(date +%F)}" ;;
    sync) git pull --rebase && git push ;;
    undo) git reset --soft HEAD~1 ;;
    log) git log --oneline --graph -20 ;;
    setup) n=$(ask_in "Name:"); e=$(ask_in "Email:"); git config --global user.name "$n"; git config --global user.email "$e"; git config --global init.defaultBranch main ;;
    *) git "$a" "$@" ;;
  esac
}
cmd_python() { need python3 pip3; [ $# -gt 0 ] && exec python3 "$@"; python3 --version; say "venv: python3 -m venv .venv && . .venv/bin/activate" "venv: python3 -m venv .venv && . .venv/bin/activate" "venv: python3 -m venv .venv && . .venv/bin/activate" "venv: python3 -m venv .venv && . .venv/bin/activate"; exec python3; }
