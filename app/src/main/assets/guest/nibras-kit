    zsh) need zsh git curl
      [ -d "$HOME/.oh-my-zsh" ] || RUNZSH=no CHSH=no KEEP_ZSHRC=yes sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
      c=${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins
      [ -d "$c/zsh-autosuggestions" ] || git clone -q --depth 1 https://github.com/zsh-users/zsh-autosuggestions "$c/zsh-autosuggestions"
      [ -d "$c/zsh-syntax-highlighting" ] || git clone -q --depth 1 https://github.com/zsh-users/zsh-syntax-highlighting "$c/zsh-syntax-highlighting"
      [ -f "$HOME/.zshrc" ] && sed -i 's/^plugins=(git)$/plugins=(git zsh-autosuggestions zsh-syntax-highlighting)/' "$HOME/.zshrc"
      nibras-shell zsh ;;
    fish) need fish; nibras-shell fish ;;
    editors) for t in vim nvim nano micro emacs; do nibras-need "$t" >/dev/null 2>&1 || true; done ;;
    tmux) need tmux; nibras-need screen >/dev/null 2>&1 || true ;;
    code-server) need curl
      if ! has code-server; then
        v=4.96.4; a=$(uname -m); case "$a" in aarch64) a=arm64 ;; armv7l|armv8l|arm*) a=armv7l ;; x86_64) a=amd64 ;; esac
        curl -fL "https://github.com/coder/code-server/releases/download/v$v/code-server-$v-linux-$a.tar.gz" | tar -xz -C /opt && ln -sf "/opt/code-server-$v-linux-$a/bin/code-server" /usr/local/bin/code-server
      fi
