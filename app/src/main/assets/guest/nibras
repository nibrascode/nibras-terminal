#!/bin/sh
# nibras: one entry point for every Nibras Terminal tool.
case "${1:-menu}" in
  menu) exec nibras-kit menu ;;
  list|tools) exec nibras-kit list ;;
  help|-h|--help) exec nibras-help ;;
  hosts|ssh) shift; [ $# -gt 0 ] && exec nibras-need ssh && exec ssh "$@"; exec nibras-api hosts ;;
  edit) shift; exec nibras-api edit "$@" ;;
  files|fm) shift; exec nibras-api files "$@" ;;
  desktop) shift; exec nibras-desktop "$@" ;;
  adb) shift; exec nibras-adb "$@" ;;
  apk) shift; exec nibras-apk "$@" ;;
  sshd) shift; exec nibras-sshd "$@" ;;
  shell) shift; exec nibras-shell "$@" ;;
  need) shift; exec nibras-need "$@" ;;
  install|add) shift; exec nibras-kit install "$@" ;;
  video|audio|image|pdf|download|dl|web|git|py|python|node|backup|net|ocr) n=$1; shift; exec nibras-kit "$n" "$@" ;;
  *) n=$1; shift
     if command -v "nibras-$n" >/dev/null 2>&1; then
       _p=$(command -v "nibras-$n")
       # Android 10+ cannot exec() scripts in app storage; fall back to sh.
       exec "$_p" "$@" || exec sh "$_p" "$@"
     fi
     echo "nibras: $n?"
     exec nibras-help
     ;;
esac
