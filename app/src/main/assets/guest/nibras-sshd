#!/bin/sh
# SSH server for this environment: nibras-sshd [port] | nibras-sshd stop   (default port 8022)
# Key only. Password login is off. It asks on the phone before it starts, and it never starts at boot.
. /usr/local/share/nibras/msg.sh
if [ -n "${NIBRAS_BOOT:-}" ]; then nmsg sshd_boot; exit 1; fi
if [ "${1:-}" = stop ]; then pkill -f "sshd -p" 2>/dev/null; nmsg sshd_off; exit 0; fi
port="${1:-8022}"
[ -x /usr/sbin/sshd ] || nibras-need sshd || exit 1
ans=$(nibras-dialog confirm -t "Nibras" -i @sshd 2>/dev/null || true)
printf '%s' "$ans" | grep -q '"text":"yes"' || { echo refused; exit 1; }
ssh-keygen -A >/dev/null 2>&1
mkdir -p /run/sshd /var/empty "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
if [ ! -s "$HOME/.ssh/authorized_keys" ]; then nmsg sshd_need_key; exit 1; fi
ip=$(ip -4 route get 1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p'); [ -n "$ip" ] || ip='<phone-ip>'
/usr/sbin/sshd -p "$port" -o PermitRootLogin=prohibit-password -o PasswordAuthentication=no -o KbdInteractiveAuthentication=no && nmsg sshd_on "$port" "$port" "$ip"
