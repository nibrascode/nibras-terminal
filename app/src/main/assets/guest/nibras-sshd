#!/bin/sh
# SSH server for this environment: nibras-sshd [port] | nibras-sshd stop   (default port 8022)
. /usr/local/share/nibras/msg.sh
if [ "${1:-}" = stop ]; then pkill -f "sshd -p" 2>/dev/null; nmsg sshd_off; exit 0; fi
port="${1:-8022}"
[ -x /usr/sbin/sshd ] || nibras-need sshd || exit 1
ssh-keygen -A >/dev/null 2>&1
mkdir -p /run/sshd /var/empty "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
if ! grep -q '^root:[^!*]' /etc/shadow 2>/dev/null && [ ! -s "$HOME/.ssh/authorized_keys" ]; then
  nmsg set_password; passwd root
fi
ip=$(ip -4 route get 1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p'); [ -n "$ip" ] || ip='<phone-ip>'
/usr/sbin/sshd -p "$port" -o PermitRootLogin=yes -o PasswordAuthentication=yes && nmsg sshd_on "$port" "$port" "$ip"
