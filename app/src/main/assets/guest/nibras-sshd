#!/bin/sh
# Start an SSH server on port 8022 (like Termux). Usage: nibras-sshd [port]
port="${1:-8022}"
if ! command -v sshd >/dev/null 2>&1 && [ ! -x /usr/sbin/sshd ]; then
  if command -v apk >/dev/null 2>&1; then apk add openssh; else pkg install openssh-server; fi
fi
ssh-keygen -A >/dev/null 2>&1
mkdir -p /run/sshd /var/empty
if ! grep -q '^root:[^!*]' /etc/shadow 2>/dev/null; then
  echo "Set a password for root first:"; passwd root
fi
/usr/sbin/sshd -p "$port" -o PermitRootLogin=yes -o PasswordAuthentication=yes && \
  echo "sshd listening on port $port. From another device: ssh -p $port root@<phone-ip>"
