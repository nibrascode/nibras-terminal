#!/bin/sh
# Local ADB shell without root (LADB / AShell style), through Android Wireless debugging.
#   nibras-adb pair      pair once with the 6-digit code
#   nibras-adb connect   connect to this phone
#   nibras-adb shell     open an ADB shell (uid shell: pm, am, settings, dumpsys, …)
#   nibras-adb <adb args>
. /usr/local/share/nibras/msg.sh
nibras-need adb || exit 1
act="${1:-shell}"; [ $# -gt 0 ] && shift
case "$act" in
  pair)
    nmsg adb_pair
    printf 'port: '; read -r p; printf 'code: '; read -r c
    exec adb pair "127.0.0.1:$p" "$c" ;;
  connect)
    p="${1:-}"; if [ -z "$p" ]; then nmsg adb_port; printf 'port: '; read -r p; fi
    adb connect "127.0.0.1:$p" && echo "$p" > "$HOME/.nibras/adb-port" ;;
  shell)
    if ! adb devices | grep -q 'device$'; then
      p=$(cat "$HOME/.nibras/adb-port" 2>/dev/null)
      [ -n "$p" ] && adb connect "127.0.0.1:$p" >/dev/null 2>&1
    fi
    adb devices | grep -q 'device$' || { nmsg adb_none; exit 1; }
    exec adb shell "$@" ;;
  *) exec adb "$act" "$@" ;;
esac
