#!/bin/sh
# scripts: community script store. Browse, read the source, install, run, update and remove small scripts.
# Catalog: catalog/scripts in the Nibras Terminal repository (every script is checked against its sha256).
. /usr/local/share/nibras/msg.sh
BUNDLED=/usr/local/share/nibras/scripts
CACHE=$HOME/.local/share/nibras/store
BIN=$HOME/bin
RAW=${NIBRAS_SCRIPTS_URL:-https://raw.githubusercontent.com/nibrascode/nibras-terminal/main/catalog/scripts}
mkdir -p "$BIN"
idx() { if [ -s "$CACHE/index.tsv" ]; then echo "$CACHE/index.tsv"; else echo "$BUNDLED/index.tsv"; fi; }
src() { if [ -s "$CACHE/$1.sh" ]; then echo "$CACHE/$1.sh"; else echo "$BUNDLED/$1.sh"; fi; }
col() { # column of the user's language in index.tsv (4 = English)
  awk -F'\t' -v l="${NIBRAS_LANG:-en}" 'NR==1 { sub(/^# /, ""); for (i = 1; i <= NF; i++) if ($i == l) { print i; exit } print 4; exit }' "$(idx)"
}
sha() { sha256sum "$1" 2>/dev/null | cut -d' ' -f1; }
want() { awk -F'\t' -v id="$1" '$1 == id { print $3; exit }' "$(idx)"; }
installed() { [ -f "$BIN/$1" ] && grep -q '^# nibras-store:' "$BIN/$1" 2>/dev/null; }
die() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }
known() { [ -n "$(want "$1")" ] || die "$(nsay "Unknown script (see: scripts list)" "Naməlum skript (bax: scripts list)" "Bilinmeyen betik (bak: scripts list)" "Неизвестный скрипт (см. scripts list)"): $1"; }

list() { # [category|word]
  c=$(col); f=${1:-}
  awk -F'\t' -v c="$c" -v f="$f" -v bin="$BIN" '
    /^#/ { next }
    /^@/ { name[substr($1, 2)] = $c; next }
    { if (f != "" && $2 != f && index(tolower($1 " " $c), tolower(f)) == 0) next
      if ($2 != last) { printf "\n\033[1;33m%s\033[0m\n", name[$2]; last = $2 }
      mark = (system("grep -q \"^# nibras-store:\" \"" bin "/" $1 "\" 2>/dev/null") == 0) ? "\033[32m✓\033[0m" : " "
      printf " %s \033[1;32m%-16s\033[0m %s\n", mark, $1, $c }' "$(idx)"
  echo
  nsay "scripts show <name> · scripts install <name> · scripts run <name> · scripts update · scripts remove <name>" \
       "scripts show <ad> · scripts install <ad> · scripts run <ad> · scripts update · scripts remove <ad>" \
       "scripts show <ad> · scripts install <ad> · scripts run <ad> · scripts update · scripts remove <ad>" \
       "scripts show <имя> · scripts install <имя> · scripts run <имя> · scripts update · scripts remove <имя>"
}

show() { known "$1"; f=$(src "$1")
  printf '\033[1;33m── %s (sha256 %s) ──\033[0m\n' "$1" "$(want "$1" | cut -c1-16)…"
  if [ -t 1 ] && command -v less >/dev/null 2>&1; then less -R "$f"; else cat "$f"; fi
}

install_one() { # id [-y]
  known "$1"; f=$(src "$1")
  [ "$(sha "$f")" = "$(want "$1")" ] || die "$1: $(nsay "checksum mismatch — not installed. Run: scripts update" "yoxlama cəmi uyğun deyil — quraşdırılmadı. İşlət: scripts update" "sağlama toplamı uyuşmuyor — kurulmadı. Çalıştır: scripts update" "контрольная сумма не совпадает — не установлено. Выполните: scripts update")"
  if [ "${2:-}" != -y ] && [ -t 0 ]; then
    printf '%s ' "$(nsay "Read the source first? [Y/n]" "Əvvəlcə mənbə koduna baxılsın? [B/x]" "Önce kaynak koda bakılsın mı? [E/h]" "Сначала посмотреть исходный код? [Д/н]")"; read -r a
    case "$a" in n|N|x|X|h|H|н|Н) ;; *) show "$1" ;; esac
    printf '%s ' "$1 — $(nsay "Install this script? [y/N]" "Bu skript quraşdırılsın? [b/X]" "Bu betik kurulsun mu? [e/H]" "Установить этот скрипт? [д/Н]")"; read -r a
    case "$a" in y|Y|b|B|e|E|д|Д) ;; *) exit 1 ;; esac
  fi
  { head -1 "$f"; echo "# nibras-store: $1 $(want "$1")"; tail -n +2 "$f"; } > "$BIN/$1" && chmod 755 "$BIN/$1"
  printf '\033[32m✓\033[0m %s → ~/bin/%s\n' "$(nsay "Installed" "Quraşdırıldı" "Kuruldu" "Установлено")" "$1"
}

remove_one() { installed "$1" || die "$(nsay "Not installed" "Quraşdırılmayıb" "Kurulu değil" "Не установлено"): $1"
  rm -f "$BIN/$1"; printf '\033[32m✓\033[0m %s %s\n' "$(nsay "Removed" "Silindi" "Kaldırıldı" "Удалено")" "$1"; }

update() {
  mkdir -p "$CACHE.new"
  curl -fsSL -m 30 "$RAW/index.tsv" -o "$CACHE.new/index.tsv" || { rm -rf "$CACHE.new"; die "$(nsay "No connection to the script catalog" "Skript kataloquna qoşulmaq olmadı" "Betik kataloğuna bağlanılamadı" "Нет связи с каталогом скриптов")"; }
  n=0; bad=0
  for id in $(awk -F'\t' '!/^[#@]/ { print $1 }' "$CACHE.new/index.tsv"); do
    w=$(awk -F'\t' -v id="$id" '$1 == id { print $3 }' "$CACHE.new/index.tsv")
    if [ "$(sha "$BUNDLED/$id.sh")" = "$w" ]; then cp "$BUNDLED/$id.sh" "$CACHE.new/$id.sh"
    elif [ "$(sha "$CACHE/$id.sh")" = "$w" ]; then cp "$CACHE/$id.sh" "$CACHE.new/$id.sh"
    else curl -fsSL -m 30 "$RAW/$id.sh" -o "$CACHE.new/$id.sh" && [ "$(sha "$CACHE.new/$id.sh")" = "$w" ] || { rm -f "$CACHE.new/$id.sh"; bad=$((bad + 1)); }; fi
  done
  rm -rf "$CACHE"; mv "$CACHE.new" "$CACHE"
  for f in "$BIN"/*; do
    [ -f "$f" ] || continue; line=$(sed -n 2p "$f"); case "$line" in "# nibras-store: "*) ;; *) continue ;; esac
    id=${line#\# nibras-store: }; old=${id#* }; id=${id%% *}
    [ -s "$CACHE/$id.sh" ] && [ "$old" != "$(want "$id")" ] && install_one "$id" -y && n=$((n + 1))
  done
  echo "$(nsay "Catalog updated" "Kataloq yeniləndi" "Katalog güncellendi" "Каталог обновлён") · $(awk '!/^[#@]/' "$(idx)" | wc -l) · ↑$n"
  [ "$bad" -eq 0 ] || echo "⚠ $bad $(nsay "scripts failed the checksum and were skipped" "skript yoxlamadan keçmədi, buraxıldı" "betik doğrulamadan geçmedi, atlandı" "скриптов не прошли проверку и пропущены")"
}

a=${1:-list}; [ $# -gt 0 ] && shift
case "$a" in
  list|ls|"") list "${1:-}" ;;
  search|find) [ -n "${1:-}" ] || die "scripts search <word>"; list "$1" ;;
  show|info|cat|source) [ -n "${1:-}" ] || die "scripts show <name>"; show "$1" ;;
  install|add) [ -n "${1:-}" ] || die "scripts install <name>"; for i in "$@"; do [ "$i" = -y ] || install_one "$i" "$(case " $* " in *" -y "*) echo -y ;; esac)"; done ;;
  run) [ -n "${1:-}" ] || die "scripts run <name> [args]"; id=$1; shift; installed "$id" || install_one "$id"; exec "$BIN/$id" "$@" ;;
  remove|rm|uninstall) [ -n "${1:-}" ] || die "scripts remove <name>"; for i in "$@"; do remove_one "$i"; done ;;
  update|upgrade) update ;;
  installed) for f in "$BIN"/*; do sed -n '2s/^# nibras-store: \([^ ]*\).*/\1/p' "$f" 2>/dev/null; done ;;
  help|-h|--help) list >/dev/null; sed -n '2,3s/^# //p' "$0" ;;
  *) die "scripts list|search|show|install|run|update|remove|installed" ;;
esac
