#!/bin/sh
# remote (also: web): use this terminal from a computer browser on the same Wi-Fi.
#   remote [on] [port] · remote off · remote status
# Safe by default: LAN only, one-time link (the first browser that opens it gets in, then the link stops working),
# stops by itself after 30 minutes without a browser. Everything is served by the app; nothing goes through the internet.
. /usr/local/share/nibras/msg.sh
case "${1:-on}" in
  on|start)
    url=$(nibras-api remote-server on ${2:-}) || exit 1
    case "$url" in http*) ;; *) echo "$url"; exit 1 ;; esac
    echo
    printf '\033[1;33m%s\033[0m\n' "$(nsay "Open this on your computer (same Wi-Fi). The link works once:" "Bunu kompüterdə aç (eyni Wi-Fi). Link bir dəfə işləyir:" "Bunu bilgisayarda aç (aynı Wi-Fi). Bağlantı bir kez çalışır:" "Откройте на компьютере (тот же Wi-Fi). Ссылка одноразовая:")"
    printf '\n  \033[1;32m%s\033[0m\n\n' "$url"
    command -v qrencode >/dev/null 2>&1 || nibras-need qrencode >/dev/null 2>&1
    command -v qrencode >/dev/null 2>&1 && qrencode -t ansiutf8 -m 1 "$url"
    nsay "Files: the 📁 button in the browser (download / drag-and-drop upload). Stop: remote off (or the notification)." \
         "Fayllar: brauzerdə 📁 düyməsi (endirmə / sürüşdürüb yükləmə). Dayandır: remote off (və ya bildiriş)." \
         "Dosyalar: tarayıcıda 📁 düğmesi (indirme / sürükle-bırak yükleme). Durdur: remote off (veya bildirim)." \
         "Файлы: кнопка 📁 в браузере (скачать / перетащить для загрузки). Стоп: remote off (или уведомление)."
    ;;
  off|stop) nibras-api remote-server off >/dev/null && nsay "Remote access stopped" "Uzaqdan giriş dayandırıldı" "Uzaktan erişim durduruldu" "Удалённый доступ остановлен" ;;
  status) nibras-api remote-server status ;;
  *) sed -n '2,5s/^# //p' "$0" ;;
esac
